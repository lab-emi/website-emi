---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PageIntro from '../../components/PageIntro.astro';
import Arrow from '../../components/Arrow.astro';
import { href, site } from '../../lib/site';
export async function getStaticPaths(){return (await getCollection('projects')).map(entry=>({params:{id:entry.id},props:{entry}}));}
const {entry}=Astro.props;
const {Content}=await render(entry);
---
<Layout title={entry.data.title} description={entry.data.summary} active="MSc Projects"><div class="wrap breadcrumb"><a href={href('/msc-projects/')}>MSc projects</a><span>/</span><span>{entry.data.status} project</span></div><PageIntro eyebrow="MSc thesis project" title={entry.data.title} description={entry.data.summary} /><section class="wrap project-detail"><aside><p class="eyebrow">Preferred skills</p><ul>{entry.data.skills.map(skill=><li>{skill}</li>)}</ul><p class="application-note">Send your CV and transcripts, and mention this project in your email.</p><a class="button" href={`mailto:${site.email}?subject=${encodeURIComponent('MSc project: '+entry.data.title)}`}>Discuss this project <Arrow diagonal size={15} /></a><a class="text-link" href={href('/msc-projects/')}>All MSc projects <Arrow /></a></aside><div>{entry.data.image&&<img class="detail-image" src={href(entry.data.image)} alt={`Illustration for ${entry.data.title}`} width="1280" height="720" />}<div class="prose"><Content /></div></div></section></Layout>
<style>.project-detail{display:grid;grid-template-columns:260px minmax(0,740px);gap:75px;padding-top:20px;padding-bottom:85px}.project-detail aside{align-self:start;position:sticky;top:125px;border-top:1px solid var(--line);padding-top:25px}.project-detail aside ul{padding-left:17px;font-size:.87rem;line-height:1.8;margin-bottom:25px}.project-detail aside li{margin-bottom:9px}.application-note{font-size:.81rem;line-height:1.8;color:var(--muted)}.project-detail .button{font-size:.76rem;padding:12px 15px}.project-detail .text-link{font-size:.77rem;margin-top:20px}.detail-image{width:100%;max-height:400px;object-fit:contain;margin-bottom:35px;border:1px solid var(--line);border-radius:3px;padding:20px}@media(max-width:900px){.project-detail{grid-template-columns:220px 1fr;gap:35px}}@media(max-width:650px){.project-detail{grid-template-columns:1fr;gap:35px}.project-detail aside{position:static;order:2}.detail-image{max-height:300px}.project-detail .text-link{display:flex;max-width:200px}}</style>
