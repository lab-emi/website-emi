---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PageIntro from '../../components/PageIntro.astro';
import Arrow from '../../components/Arrow.astro';
import { href, thumb, site } from '../../lib/site';
const projects=(await getCollection('projects')).sort((a,b)=>a.data.title.localeCompare(b.data.title));
---
<Layout title="MSc projects" active="Join us" description="Explore open master's thesis projects in efficient AI, FPGA accelerators and learning-based mixed-signal calibration at TU Delft."><PageIntro eyebrow="Master's thesis opportunities" title="Make your ideas work." description="Work on a research problem that connects algorithms to hardware. Explore our open MSc projects and find a direction that interests you." /><section class="wrap projects-section"><p class="project-invitation">Interested in a project? Send your <strong>CV and transcripts</strong> to <a href={`mailto:${site.email}`}>{site.email}</a> to arrange a conversation.</p><div class="project-list">{projects.map((project,index)=><article class="project-card"><div class="project-number">0{index+1}</div><div class="project-content"><div class="project-status"><span class="status-dot"></span>{project.data.status} · MSc thesis</div><h2><a href={href(`/msc-projects/${project.id}/`)}>{project.data.title}</a></h2><p>{project.data.summary}</p><div class="project-skills">{project.data.skills.map(skill=><span class="pill">{skill}</span>)}</div><a class="text-link" href={href(`/msc-projects/${project.id}/`)}>Project details <Arrow /></a></div>{project.data.image&&<a class="project-image" href={href(`/msc-projects/${project.id}/`)} tabindex="-1" aria-hidden="true"><img src={thumb(project.data.image)} alt="" loading="lazy" width="800" height="600" /></a>}</article>)}</div></section></Layout>
<style>.projects-section{padding-bottom:80px}.project-invitation{background:var(--pale);border-left:3px solid var(--blue);padding:23px 27px;font-size:.9rem;line-height:1.8;margin-bottom:42px}.project-invitation a{color:var(--blue);text-decoration:underline}.project-card{display:grid;grid-template-columns:45px 1fr auto;gap:28px;padding:35px 0;border-top:1px solid var(--line)}.project-number{font-size:.79rem;color:var(--blue);padding-top:4px}.project-status{display:flex;align-items:center;gap:7px;font-size:.75rem;color:var(--blue);font-weight:650;margin-bottom:13px}.status-dot{width:5px;height:5px;border-radius:50%;background:var(--blue)}.project-card h2{font-size:1.75rem;line-height:1.35;letter-spacing:-.03em;max-width:680px;margin-bottom:15px}.project-card h2 a:hover{color:var(--blue)}.project-card p{color:var(--muted);font-size:.89rem;max-width:630px;line-height:1.85}.project-skills{display:flex;flex-wrap:wrap;gap:7px;margin-bottom:16px}.project-skills .pill{font-size:.75rem}.project-image{display:flex;align-items:center;justify-content:center;background:var(--pale);width:235px;align-self:start;margin-top:12px;border-radius:3px;padding:10px}.project-image img{width:100%;max-height:190px;object-fit:contain}.project-card .text-link{font-size:.79rem}@media(max-width:900px){.project-image{width:160px}.project-card{grid-template-columns:30px 1fr auto;gap:20px}.project-card h2{font-size:1.5rem}}@media(max-width:650px){.project-card{grid-template-columns:1fr;gap:15px}.project-image{width:100%;max-width:350px;grid-row:2}.project-number{font-size:.75rem}.project-invitation{padding:20px;font-size:.85rem}.project-card h2{font-size:1.5rem}.project-skills .pill{font-size:.75rem}}
</style>
