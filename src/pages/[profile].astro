---
import Layout from '../layouts/Layout.astro';
import Arrow from '../components/Arrow.astro';
import Lightbox from '../components/Lightbox.astro';
import { href, thumb, localizeHtml } from '../lib/site';
import profiles from '../data/profiles.json';

export function getStaticPaths(){return profiles.map(profile=>({params:{profile:profile.id},props:{profile}}));}
const {profile}=Astro.props;
const portrait=profile.images[profile.id==='zitao-liang'?1:0];
const html=profile.html.replace(/<h1>.*?<\/h1>/,'').replace('<p>🎓 <strong>MORE FORMAL BIO</strong>','<h2>More formal bio</h2><p>').replace('<p>🌟 <strong>THIS IS ME</strong></p>','<h2>This is me</h2>');
const photos=profile.id==='zitao-liang'?profile.images.slice(2):[];
const social=profile.links.filter(l=>l.url.includes('linkedin.com')||l.url.includes('github.com'));
---
<Layout title={profile.name} active="People" description={`${profile.name}, PhD researcher in the EMI lab at TU Delft.`}><section class="wrap profile-page"><a class="back-link" href={href('/people/')}><Arrow size={15} />Our people</a><div class="profile-layout"><aside><img class="profile-photo" src={thumb(portrait.src)} alt={profile.name} width={portrait.width} height={portrait.height} /><div class="profile-social">{social.map(l=><a href={l.url}>{l.label}<Arrow diagonal size={14} /></a>)}</div>{profile.id==='zitao-liang'&&<a class="profile-scene" href={href(profile.images[0].src)} data-lightbox data-caption="From Zitao’s personal gallery" aria-label="Enlarge Zitao’s mountain photograph"><img src={thumb(profile.images[0].src)} alt="Zitao looking toward snow-covered mountains" width={profile.images[0].width} height={profile.images[0].height} loading="lazy" /></a>}</aside><article><p class="eyebrow">EMI group member</p><h1>{profile.name}</h1><div class="prose" set:html={localizeHtml(html)} />{photos.length>0&&<section class="profile-photos"><h2>Research & life.</h2><p>From a first 22 nm tapeout to calligraphy.</p><div>{photos.map((photo,i)=><figure><a href={href(photo.src)} data-lightbox data-caption={i===0?"Zitao's first 22 nm tapeout":i===1?"Zitao's calligraphy":`Zitao's gallery · ${i+1}`} aria-label={`Enlarge gallery image ${i+1}`}><img src={thumb(photo.src)} alt={i===0?"Zitao's first 22 nm tapeout":i===1?"Zitao's calligraphy":`From Zitao's personal gallery, image ${i+1}`} width={photo.width} height={photo.height} loading="lazy" /></a>{i<2&&<figcaption>{i===0?"Zitao's first 22 nm tapeout":"Zitao's calligraphy"}</figcaption>}</figure>)}</div></section>}</article></div></section><Lightbox /></Layout>
<style>.profile-page{padding-top:40px;padding-bottom:80px}.profile-layout{display:grid;grid-template-columns:260px minmax(0,750px);gap:65px;margin-top:40px}.profile-layout aside{align-self:start}.profile-scene{display:block;margin-top:34px}.profile-scene img{border-radius:3px;width:100%}.profile-photo{width:100%;max-height:330px;object-fit:cover;border-radius:3px}.profile-layout h1{font-size:3.7rem;margin-bottom:25px}.profile-social{display:flex;flex-wrap:wrap;gap:15px;margin-top:20px}.profile-social a{display:flex;align-items:center;gap:6px;font-size:.8rem;color:var(--blue)}.profile-photos{margin-top:50px}.profile-photos h2{font-size:2rem;margin-bottom:10px}.profile-photos>p{font-size:.87rem;color:var(--muted)}.profile-photos>div{columns:2;column-gap:20px}.profile-photos figure{margin:0 0 20px;break-inside:avoid}.profile-photos img{border-radius:3px;width:100%}.profile-photos figcaption{font-size:.75rem;color:var(--muted);margin-top:9px}@media(max-width:900px){.profile-layout{grid-template-columns:210px 1fr;gap:35px}.profile-layout h1{font-size:3rem}}@media(max-width:600px){.profile-layout{grid-template-columns:1fr;gap:30px}.profile-layout aside{position:static}.profile-photo{width:180px;max-height:220px}.profile-layout h1{font-size:2.6rem}.profile-photos>div{columns:1}}</style>
