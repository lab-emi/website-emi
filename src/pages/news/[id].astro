---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Arrow from '../../components/Arrow.astro';
import Lightbox from '../../components/Lightbox.astro';
import { href, thumb, dateLabel } from '../../lib/site';
export async function getStaticPaths() { return (await getCollection('news')).map(entry=>({params:{id:entry.id},props:{entry}})); }
const { entry } = Astro.props;
const { Content } = await render(entry);
const news=(await getCollection('news')).sort((a,b)=>b.data.date.getTime()-a.data.date.getTime());
const related=news.filter(n=>n.id!==entry.id&&n.data.category===entry.data.category).slice(0,3);
---
<Layout title={entry.data.title} description={entry.data.summary} active="News">
  <div class="wrap breadcrumb"><a href={href('/')}>Home</a><span>/</span><a href={href('/news/')}>News</a><span>/</span><span>{entry.data.category}</span></div>
  <article class="wrap article"><header class="article-heading"><p class="eyebrow">{entry.data.category}<span>·</span><time datetime={entry.data.date.toISOString()}>{dateLabel(entry.data.date)}</time></p><h1>{entry.data.title}</h1></header><figure class="article-hero"><a href={href(entry.data.image)} data-lightbox data-caption={entry.data.title} aria-label="Enlarge article image"><img src={href(entry.data.image)} alt={entry.data.title} width="1280" height="780" /></a></figure><div class="article-layout"><aside><p class="eyebrow">From the lab</p><p>EMI Lab<br />TU Delft</p><a class="text-link" href={href('/news/')}>All news <Arrow /></a></aside><div><div class="prose">{entry.data.archivedOpportunity && <p class="notice"><strong>Archived opportunity.</strong> The application deadline in this announcement has passed. See <a href={href('/join-us/')}>Join us</a> for current information.</p>}<Content />{entry.data.titleUrl&&<p><a href={entry.data.titleUrl}>Related announcement <Arrow diagonal size={14} /></a></p>}</div>{entry.data.images.length>1 && <div class="article-photos">{entry.data.images.slice(1).map((src,i)=><a href={href(src)} data-lightbox data-caption={`${entry.data.title} — image ${i+2}`} aria-label={`Enlarge article image ${i+2}`}><img src={thumb(src)} alt={`${entry.data.title} — image ${i+2}`} loading="lazy" width="800" height="600" /></a>)}</div>}</div></div></article>
  {related.length>0 && <section class="section-soft section"><div class="wrap"><div class="section-title"><h2>More from EMI.</h2><a class="text-link" href={href('/news/')}>All news <Arrow /></a></div><div class="related-news">{related.map(n=><a href={href(`/news/${n.id}/`)}><time datetime={n.data.date.toISOString()}>{dateLabel(n.data.date)}</time><h3>{n.data.title}</h3><Arrow diagonal /></a>)}</div></div></section>}
  <Lightbox />
</Layout>
<style>.article{padding-top:48px;padding-bottom:85px}.article-heading{max-width:970px}.article-heading h1{font-size:clamp(2.25rem,4.7vw,4rem);line-height:1.2;letter-spacing:-.035em;margin-bottom:35px}.article-heading .eyebrow{font-size:.75rem;letter-spacing:.08em}.article-hero{margin:0 0 50px;background:var(--pale);border-radius:4px;overflow:hidden}.article-hero img{max-height:570px;width:100%;object-fit:contain}.article-layout{display:grid;grid-template-columns:220px minmax(0,750px);gap:65px}.article-layout aside{font-size:.86rem;color:var(--muted);align-self:start;position:sticky;top:125px}.article-layout aside .eyebrow{font-size:.75rem}.article-photos{display:grid;grid-template-columns:repeat(2,1fr);gap:20px;margin-top:35px}.article-photos img{width:100%;height:280px;object-fit:cover;border-radius:3px}.related-news{display:grid;grid-template-columns:repeat(3,1fr);gap:35px}.related-news a{display:block;border-top:1px solid var(--line);padding-top:20px}.related-news time{font-size:.75rem;color:var(--muted)}.related-news h3{font-size:1.13rem;line-height:1.5;letter-spacing:-.02em;margin:13px 0 20px}.related-news a:hover h3{color:var(--blue)}@media(max-width:900px){.article-layout{grid-template-columns:150px 1fr;gap:35px}.article-photos img{height:200px}}@media(max-width:650px){.article{padding-top:32px;padding-bottom:55px}.article-layout{grid-template-columns:1fr;gap:25px}.article-layout aside{position:static;display:none}.article-hero{margin-bottom:30px}.article-heading h1{font-size:2rem}.article-photos{grid-template-columns:1fr}.article-photos img{height:auto}.related-news{grid-template-columns:1fr;gap:25px}.article-hero img{max-height:430px}}
</style>
