---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import Lightbox from '../components/Lightbox.astro';
import { href, thumb, localizeHtml } from '../lib/site';
import gallery from '../data/gallery.json';
const categories = ['All', ...new Set(gallery.map(p=>p.group))];
---
<Layout title="Life at EMI" active="Gallery" description="Life at the EMI lab: students at conferences, shared moments, and photography from around the world.">
  <PageIntro eyebrow="Life at EMI" title="Beyond the paper." description="Presentations, shared milestones, everyday moments — and a little photography along the way." />
  <section class="wrap gallery-section"><div class="filter-bar gallery-filters" role="group" aria-label="Photo categories">{categories.map(c=><button class="filter-tab" data-category={c} aria-pressed={c==='All'}>{c}</button>)}<span id="gallery-count" aria-live="polite">{gallery.length} photographs</span></div><div class="gallery-grid">{gallery.map((photo,index)=><figure data-group={photo.group}><a href={href(photo.image)} data-lightbox data-caption={photo.caption} aria-label={`Enlarge: ${photo.caption}`}><img src={thumb(photo.image)} alt={photo.caption} width={photo.width} height={photo.height} loading={index<3?'eager':'lazy'} /><span aria-hidden="true">↗</span></a><figcaption set:html={localizeHtml(photo.captionHtml)} /></figure>)}</div></section>
  <Lightbox />
  <script>
    const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-category]')];
    const figures = [...document.querySelectorAll<HTMLElement>('[data-group]')];
    buttons.forEach(button=>button.addEventListener('click',()=>{ buttons.forEach(b=>b.setAttribute('aria-pressed',String(b===button))); let count=0; figures.forEach(f=>{f.hidden=button.dataset.category!=='All'&&f.dataset.group!==button.dataset.category;if(!f.hidden)count++;}); document.querySelector('#gallery-count')!.textContent=`${count} photographs`; }));
  </script>
</Layout>
<style>
  .gallery-section{padding-bottom:85px}.gallery-filters{margin-bottom:34px}.gallery-filters>span{margin-left:auto;font-size:.75rem;color:var(--muted)}.gallery-grid{columns:3;column-gap:26px}.gallery-grid figure{break-inside:avoid;margin:0 0 30px}.gallery-grid figure>a{display:block;position:relative;overflow:hidden;background:var(--pale);border-radius:3px}.gallery-grid img{width:100%;transition:transform .3s}.gallery-grid a:hover img{transform:scale(1.025)}.gallery-grid a>span{position:absolute;right:12px;bottom:12px;display:grid;place-items:center;width:30px;height:30px;background:#fff;border-radius:50%}.gallery-grid figcaption{font-size:.875rem;line-height:1.7;margin-top:12px;color:var(--muted)}.gallery-grid figcaption :global(p){margin:0}.gallery-grid figcaption :global(a){color:var(--blue);text-decoration:underline;text-underline-offset:3px}@media(max-width:850px){.gallery-grid{columns:2;column-gap:20px}}@media(max-width:550px){.gallery-grid{columns:1}.gallery-filters{gap:4px}.gallery-filters button{font-size:.75rem;padding:7px 10px}.gallery-filters>span{flex-basis:100%;margin-top:12px}.gallery-grid figcaption{font-size:.82rem}}
</style>
