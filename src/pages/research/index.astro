---
import Layout from '../../layouts/Layout.astro';
import PageIntro from '../../components/PageIntro.astro';
import Arrow from '../../components/Arrow.astro';
import { href, site, thumb } from '../../lib/site';
import { research } from '../../data/research';
import gallery from '../../data/gallery.json';
const demos=[{id:'mzMSEo2S_hg',title:'Robotic prosthesis control',description:'Recurrent neural network control with the EdgeDRNN accelerator.',link:'http://www.bipedalrobotics.com/',label:'With AMBER Lab, Caltech'}, {id:'6pbVjSz8akY',title:'Spoken digit recognition',description:'Real-time spoken digit recognition using EdgeDRNN.',link:'https://arxiv.org/abs/2012.13600',label:'Read the EdgeDRNN paper'}, {id:'g38Up0QQEXs',title:'Neuromorphic computing',description:'Interfacing EdgeDRNN with a dynamic audio sensor.',link:'https://ieeexplore.ieee.org/abstract/document/5537164',label:'Explore the silicon cochlea'}];
---
<Layout title="Research" active="Research">
  <PageIntro eyebrow="Algorithms ↔ Hardware" title="Efficiency, by design." description="We study neuromorphic algorithm–hardware co-design for energy-efficient edge intelligence. Our work bridges learning methods, sensing systems and the hardware that makes them practical." />
  <section class="wrap research-directions">{research.map(r=><a href={href(`/research/${r.id}/`)} class="direction"><span class="direction-number">{r.number}</span><div><p class="eyebrow">{r.short}</p><h2>{r.title}</h2><p>{r.description}</p><div class="keywords">{r.keywords.map(k=><span class="pill">{k}</span>)}</div></div><Arrow diagonal size={30} /></a>)}</section>
  <section class="section section-soft"><div class="wrap"><div class="section-title"><div><p class="eyebrow">Open research</p><h2>Built to be built on.</h2></div><a class="text-link" href={site.github}>EMI on GitHub <Arrow diagonal /></a></div><div class="open-projects"><a href="https://github.com/lab-emi/OpenDPD"><div><span class="repo-label">01 / Open-source framework</span><Arrow diagonal size={23} /></div><h3>OpenDPD</h3><p>An end-to-end learning and benchmarking framework for power amplifier modeling and digital predistortion.</p><span>Code · Datasets · Benchmarks</span></a><a href="https://github.com/lab-emi/AIRHAR"><div><span class="repo-label">02 / Research project</span><Arrow diagonal size={23} /></div><h3>AIRHAR</h3><p>Energy-efficient radar-based human activity recognition, connecting efficient models and embedded hardware.</p><span>Code · Models · Reproducible research</span></a></div></div></section>
  <section class="section wrap" id="demonstrations"><div class="section-title"><div><p class="eyebrow">Research in action</p><h2>From idea to demonstration.</h2></div></div><div class="demo-grid">{demos.map(d=><article><iframe src={`https://www.youtube-nocookie.com/embed/${d.id}`} title={d.title} loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen referrerpolicy="strict-origin-when-cross-origin"></iframe><h3>{d.title}</h3><p>{d.description}</p><a href={d.link}>{d.label} <Arrow diagonal size={13} /></a><a href={`https://www.youtube.com/watch?v=${d.id}`} class="watch-link">Watch on YouTube <Arrow diagonal size={13} /></a></article>)}</div></section>
  <section class="funding-callout wrap"><div><p class="eyebrow">Research support</p><h2>Shared ambition.</h2><p>Our research is supported by public funding, industry collaborations and a community of academic partners.</p><a class="text-link" href={href('/grants-awards/')}>Grants, sponsors & awards <Arrow /></a></div><img src={thumb(gallery[9].image)} alt={gallery[9].caption} width="800" height="600" loading="lazy" /></section>
</Layout>
<style>.research-directions{padding-bottom:75px}.direction{display:grid;grid-template-columns:65px 1fr 45px;gap:28px;border-top:1px solid var(--line);padding:38px 0}.direction-number{font-size:.8rem;color:var(--blue);padding-top:5px}.direction .eyebrow{font-size:.75rem;margin-bottom:11px}.direction h2{font-size:clamp(1.7rem,3.1vw,2.55rem);margin-bottom:16px}.direction p:not(.eyebrow){font-size:.95rem;max-width:710px;line-height:1.8;color:var(--muted)}.direction>svg{margin-top:7px;transition:transform .2s}.direction:hover>svg{transform:translate(3px,-3px);color:var(--blue)}.direction:hover h2{color:var(--blue)}.keywords{display:flex;flex-wrap:wrap;gap:8px}.open-projects{display:grid;grid-template-columns:1fr 1fr;gap:30px}.open-projects>a{background:#fff;padding:30px 35px;border:1px solid var(--line);border-radius:3px}.open-projects>a>div{display:flex;align-items:center;justify-content:space-between;margin-bottom:33px;color:var(--blue)}.repo-label{font-size:.75rem}.open-projects h3{font-size:2.3rem;margin-bottom:17px}.open-projects p{color:var(--muted);font-size:.94rem;line-height:1.8;max-width:420px}.open-projects>a>span{font-size:.75rem;font-weight:650}.open-projects a:hover{border-color:var(--blue)}.demo-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:28px}.demo-grid iframe{width:100%;aspect-ratio:16/9;border:0;border-radius:3px;background:var(--pale)}.demo-grid h3{font-size:1.16rem;margin:22px 0 12px}.demo-grid p{font-size:.85rem;color:var(--muted)}.demo-grid a{font-size:.75rem;color:var(--blue);display:flex;align-items:center;gap:7px}.demo-grid .watch-link{color:var(--muted);margin-top:10px}.funding-callout{display:grid;grid-template-columns:1fr 1fr;gap:80px;border-top:1px solid var(--line);padding-top:55px;padding-bottom:80px;align-items:center}.funding-callout p:not(.eyebrow){font-size:.95rem;color:var(--muted);line-height:1.8;max-width:470px}.funding-callout img{width:100%;max-height:300px;object-fit:cover;border-radius:3px}@media(max-width:800px){.direction{grid-template-columns:40px 1fr 30px;gap:15px}.demo-grid{grid-template-columns:1fr;gap:40px}.open-projects{gap:20px}.open-projects>a{padding:24px}.funding-callout{gap:35px}}@media(max-width:550px){.direction{grid-template-columns:1fr 25px;gap:10px}.direction-number{grid-column:1/-1}.direction .eyebrow{font-size:.75rem}.direction h2{font-size:1.75rem}.direction p:not(.eyebrow){font-size:.87rem}.direction>svg{width:23px}.open-projects{grid-template-columns:1fr}.open-projects>a>div{margin-bottom:20px}.open-projects h3{font-size:2rem}.funding-callout{grid-template-columns:1fr;gap:30px;padding-bottom:50px}.keywords .pill{font-size:.75rem}}</style>
