---
import Layout from '../../layouts/Layout.astro';
import Arrow from '../../components/Arrow.astro';
import ResearchExplorer from '../../components/ResearchExplorer.astro';
import { href, site, thumb } from '../../lib/site';
import { openSourceProjects } from '../../data/open-source';
import gallery from '../../data/gallery.json';
const demos=[{id:'mzMSEo2S_hg',title:'Robotic prosthesis control',description:'Recurrent neural network control with the EdgeDRNN accelerator.',link:'http://www.bipedalrobotics.com/',label:'With AMBER Lab, Caltech'}, {id:'6pbVjSz8akY',title:'Spoken digit recognition',description:'Real-time spoken digit recognition using EdgeDRNN.',link:'https://arxiv.org/abs/2012.13600',label:'Read the EdgeDRNN paper'}, {id:'g38Up0QQEXs',title:'Neuromorphic computing',description:'Interfacing EdgeDRNN with a dynamic audio sensor.',link:'https://ieeexplore.ieee.org/abstract/document/5537164',label:'Explore the silicon cochlea'}];
---
<Layout title="Research" active="Research">
  <h1 class="sr-only">Research</h1>
  <section class="wrap research-overview" id="directions" aria-labelledby="directions-heading">
    <div class="research-heading">
      <h2 id="directions-heading">One engine. Five directions.</h2>
      <nav class="research-nav" aria-label="Research sections">
        <a href="#directions">Directions</a>
        <a href="#open-source">Open source</a>
        <a href="#demonstrations">Demonstrations</a>
      </nav>
    </div>
    <ResearchExplorer />
  </section>
  <section class="section section-soft" id="open-source" aria-labelledby="open-source-heading">
    <div class="wrap">
      <div class="section-title open-source-heading">
        <div><p class="eyebrow">EMI on GitHub</p><h2 id="open-source-heading">Open-source research.</h2><p class="open-source-intro">Explore the code, datasets and models behind our work.</p></div>
        <a class="button" href={site.github}>View all repositories <Arrow diagonal size={18} /></a>
      </div>
      <div class="open-projects">{openSourceProjects.map(project=><a href={project.url} aria-label={`${project.name} on GitHub`}><div><span class="repo-label">{project.topic}</span><Arrow diagonal size={23} /></div><h3>{project.name}</h3><p>{project.description}</p><span>{project.resources}</span></a>)}</div>
    </div>
  </section>
  <section class="section wrap" id="demonstrations"><div class="section-title"><div><p class="eyebrow">Research in action</p><h2>From idea to demonstration.</h2></div></div><div class="demo-grid">{demos.map(d=><article><iframe src={`https://www.youtube-nocookie.com/embed/${d.id}`} title={d.title} loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen referrerpolicy="strict-origin-when-cross-origin"></iframe><h3>{d.title}</h3><p>{d.description}</p><a href={d.link}>{d.label} <Arrow diagonal size={13} /></a><a href={`https://www.youtube.com/watch?v=${d.id}`} class="watch-link">Watch on YouTube <Arrow diagonal size={13} /></a></article>)}</div></section>
  <section class="funding-callout wrap"><div><p class="eyebrow">Research support</p><h2>Shared ambition.</h2><p>Our research is supported by public funding, industry collaborations and a community of academic partners.</p><a class="text-link" href={href('/grants-awards/')}>Grants, sponsors & awards <Arrow /></a></div><img src={thumb(gallery[9].image)} alt={gallery[9].caption} width="800" height="600" loading="lazy" /></section>
</Layout>
<style>
  .research-overview { padding-block: 14px 85px; }
  .research-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 6px 24px;
    margin-bottom: 14px;
  }
  .research-heading h2 { font-size: clamp(1.5rem, 3.4vw, 2.5rem); margin: 0; }
  .research-nav { display: flex; flex-wrap: wrap; gap: 3px 16px; font-size: .76rem; color: var(--muted); }
  .research-nav a { padding-block: 5px; }
  .research-nav a:hover { color: var(--blue); }

  .research-overview :global(.research-explorer) {
    --panel-padding: clamp(14px, 2.5svh, 26px);
  }
  .research-overview :global(:is(.engine-topline, .engine-bottomline)) { padding-block: 12px; }
  .research-overview :global(.research-panel--ai .research-panel-feature) { display: flex; }

  @media (min-width: 761px) {
    .research-overview :global(.research-explorer) {
      /* Reserve space for the sticky header and heading row. */
      --feature-room: clamp(19rem, calc(100svh - 11rem - 2 * var(--panel-padding)), 40rem);
    }
  }

  @media (min-width: 1251px) and (min-height: 651px) and (max-height: 760px) {
    .research-overview :global(.engine-platform) { scale: .87; }
  }

  @media (min-width: 761px) and (max-width: 900px) {
    .research-overview :global(.research-explorer) {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
    .research-overview :global(.engine-visual) {
      position: sticky;
      top: 100px;
      align-self: start;
      height: calc(var(--feature-room) + 2 * var(--panel-padding));
    }
    .research-overview :global(.engine-stage) { min-height: 0; }
    .research-overview :global(.engine-platform) { scale: .73; }
  }

  @media (min-width: 761px) and (max-width: 900px) and (max-height: 480px) {
    .research-overview :global(.engine-platform) { scale: .55; }
  }

  @media (max-width: 760px) {
    .research-overview { padding-block: 8px 55px; }
    .research-heading { row-gap: 3px; margin-bottom: 8px; }
    .research-heading h2 { font-size: clamp(1.25rem, 6.15vw, 1.75rem); }
    .research-nav a { padding-block: 4px; }
    .research-overview :global(.research-explorer) { --panel-padding: clamp(12px, 2svh, 20px); }
    .research-overview :global(.engine-topline) { padding: 8px 12px 6px; font-size: .6rem; }
    .research-overview :global(:is(.engine-topline > span:last-child, .engine-orbit, .engine-layer, .engine-traces, .engine-bottomline)) { display: none; }
    .research-overview :global(.engine-stage) { display: block; min-height: 0; padding: 0 12px 8px; }
    .research-overview :global(.engine-platform) { width: 100%; height: auto; transform: none; animation: none; }
    .research-overview :global(.research-tabs) { grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 6px; }
    .research-overview :global(.research-tabs > .research-tab) {
      position: static;
      align-items: center;
      justify-content: center;
      min-height: 44px;
      width: auto;
      height: auto;
      padding: 5px;
      text-align: center;
      transform: none;
      box-shadow: none;
    }
    .research-overview :global(.research-tabs > .research-tab > :not(.module-name)) { display: none; }
    .research-overview :global(.research-tabs > .research-tab > .module-name) { font-size: .75rem; line-height: 1.2; white-space: normal; }
    .research-overview :global(.research-panel--ai .research-panel-feature) { height: auto; gap: 8px; }
    .research-overview :global(.research-panel--ai .research-panel-feature h3) { font-size: 1.5rem; margin-bottom: 5px; }
    .research-overview :global(.research-panel--ai .research-panel-feature .eyebrow) { margin-bottom: 5px; }
    .research-overview :global(.research-panel-feature > .agentic-build) { flex: 0 0 auto; height: auto; padding-block: 8px; }
    .research-overview :global(.research-panel-feature .agentic-diagram) { flex: 0 0 auto; height: auto; max-height: min(11.25rem, 17svh); margin-block: 4px; }
    .research-overview :global(.agentic-build-steps) { padding-top: 2px; }
    .research-overview :global(.agentic-build figcaption) { margin-top: 4px; }
    .research-overview :global(.research-panel-feature > .ai-project-grid) { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
    .research-overview :global(.ai-project-grid .ai-project-link) { gap: 6px; padding: 7px 8px; }
  }

  @media (max-width: 480px) {
    .research-overview :global(.research-tabs) { grid-template-columns: repeat(6, minmax(0, 1fr)); }
    .research-overview :global(.research-tabs > .research-tab) { grid-column: span 2; }
    .research-overview :global(.research-tabs > .research-tab:nth-child(n + 4)) { grid-column: span 3; }
  }

  @media (max-width: 760px) and (max-height: 700px) {
    .research-overview :global(.agentic-build figcaption) { display: none; }
  }
</style>
<style>.open-source-heading{align-items:center;flex-wrap:wrap}.open-source-heading>div{min-width:0}.open-source-heading .button{white-space:normal;text-align:center}.open-source-intro{font-size:1rem;line-height:1.7;color:var(--muted);margin:18px 0 0;max-width:590px}.open-projects{display:grid;grid-template-columns:repeat(auto-fit,minmax(310px,1fr));gap:24px}.open-projects>a{display:flex;flex-direction:column;min-width:0;background:#fff;padding:30px 28px;border:1px solid var(--line);border-radius:3px;transition:border-color .2s}.open-projects>a>div{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-bottom:30px;color:var(--blue)}.repo-label{font-size:.875rem;font-weight:650;line-height:1.5}.open-projects h3{font-size:clamp(1.65rem,2.7vw,2.15rem);line-height:1.2;margin-bottom:17px;overflow-wrap:anywhere}.open-projects p{flex:1;color:var(--muted);font-size:1rem;line-height:1.75;max-width:540px;margin-bottom:28px}.open-projects>a>span{font-size:.875rem;font-weight:650;line-height:1.6;padding-top:18px;border-top:1px solid var(--line)}.open-projects a:hover{border-color:var(--blue)}.demo-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:28px}.demo-grid iframe{width:100%;aspect-ratio:16/9;border:0;border-radius:3px;background:var(--pale)}.demo-grid h3{font-size:1.16rem;margin:22px 0 12px}.demo-grid p{font-size:.85rem;color:var(--muted)}.demo-grid a{font-size:.75rem;color:var(--blue);display:flex;align-items:center;gap:7px}.demo-grid .watch-link{color:var(--muted);margin-top:10px}.funding-callout{display:grid;grid-template-columns:1fr 1fr;gap:80px;border-top:1px solid var(--line);padding-top:55px;padding-bottom:80px;align-items:center}.funding-callout p:not(.eyebrow){font-size:.95rem;color:var(--muted);line-height:1.8;max-width:470px}.funding-callout img{width:100%;max-height:300px;object-fit:cover;border-radius:3px}@media(max-width:950px){.open-projects{grid-template-columns:1fr}.open-projects>a>div{margin-bottom:20px}.open-projects h3{font-size:2rem}.open-source-heading{align-items:flex-start}}@media(max-width:800px){.demo-grid{grid-template-columns:1fr;gap:40px}.open-projects{gap:20px}.open-projects>a{padding:24px}.funding-callout{gap:35px}}@media(max-width:550px){.open-projects{grid-template-columns:1fr}.open-projects>a>div{margin-bottom:20px}.open-projects h3{font-size:2rem}.funding-callout{grid-template-columns:1fr;gap:30px;padding-bottom:50px}}</style>
