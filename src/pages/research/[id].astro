---
import Layout from '../../layouts/Layout.astro';
import PageIntro from '../../components/PageIntro.astro';
import Publication from '../../components/Publication.astro';
import Arrow from '../../components/Arrow.astro';
import { href } from '../../lib/site';
import { research } from '../../data/research';
import publications from '../../data/publications.json';
export function getStaticPaths() { return research.map(area=>({params:{id:area.id},props:{area}})); }
const { area }=Astro.props;
const selected=area.papers.map(prefix=>publications.find(p=>p.title.startsWith(prefix))).filter((p):p is typeof publications[number]=>Boolean(p));
---
<Layout title={area.title} description={area.description} active="Research"><div class="wrap breadcrumb"><a href={href('/research/')}>Research</a><span>/</span><span>Direction {area.number}</span></div><PageIntro eyebrow={area.short} title={area.title} description={area.detail} /><section class="wrap area-content"><aside><p class="eyebrow">Focus areas</p><ul>{area.keywords.map(k=><li>{k}</li>)}</ul>{area.repo&&<a class="button" href={area.repo}>{area.repoName} on GitHub <Arrow diagonal size={15} /></a>}<a class="text-link" href={href('/msc-projects/')}>Related MSc opportunities <Arrow /></a><a class="text-link" href={href('/research/')}>All research directions <Arrow /></a></aside><div><div class="section-title"><h2>Selected work.</h2><a class="text-link" href={href(`/publications/?topic=${encodeURIComponent(area.topic)}`)}>All publications <Arrow /></a></div>{selected.map(publication=><Publication publication={publication} compact />)}</div></section></Layout>
<style>.area-content{display:grid;grid-template-columns:280px 1fr;gap:75px;padding-top:20px;padding-bottom:90px}.area-content aside{border-top:1px solid var(--line);padding-top:25px;align-self:start;position:sticky;top:120px}.area-content aside ul{list-style:none;padding:0;margin-bottom:30px}.area-content aside li{border-bottom:1px solid var(--line);font-size:.9rem;padding:11px 0}.area-content aside .button{font-size:.76rem;padding:12px 16px;margin-bottom:25px}.area-content aside .text-link{font-size:.76rem;display:flex;justify-content:space-between;margin-top:14px}.area-content h2{font-size:1.8rem}.area-content .section-title{margin-bottom:28px}.area-content .section-title .text-link{font-size:.77rem}@media(max-width:1000px){.area-content{grid-template-columns:220px 1fr;gap:35px}}@media(max-width:650px){.area-content{grid-template-columns:1fr;gap:40px;padding-bottom:55px}.area-content aside{position:static}.area-content aside ul{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:15px}.area-content aside li{font-size:.75rem;border:1px solid var(--line);padding:5px 10px;border-radius:30px}.area-content aside .text-link{display:inline-flex;margin-right:20px;gap:10px}.area-content .section-title{gap:12px}.area-content h2{font-size:1.65rem}}</style>
