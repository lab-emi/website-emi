---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import { thumb, localizeHtml } from '../lib/site';
import funding from '../data/funding.json';
---
<Layout title="Grants & awards" description="Public research funding, industry support and awards for EMI researchers at TU Delft."><PageIntro eyebrow="Support & recognition" title="Progress, together." description="Research made possible by public funding, industry partnerships and academic collaboration. Recognition for the people and ideas behind it." /><div class="wrap"><nav class="anchor-nav" aria-label="Funding sections"><a href="#grants">Research grants</a><a href="#awards">Awards</a><a href="#sponsors">Sponsors</a></nav></div><section class="wrap funding-section" id="grants"><div class="funding-heading"><p class="eyebrow">01 / Research grants</p><h2>Backing the<br />next idea.</h2></div><div class="grant-list">{['Led by EMI','EMI as a core member'].map(scope=><div class="grant-group"><h3>{scope==='Led by EMI'?'Projects led by EMI':'Projects with EMI as a core member'}</h3>{funding.grants.filter(g=>g.scope===scope).map(g=><div class="grant prose" set:html={localizeHtml(g.html.replace(/^<li>|<\/li>$/g,''))} />)}</div>)}</div></section><section class="section section-soft" id="awards"><div class="wrap awards-layout"><div><p class="eyebrow">02 / Awards & recognition</p><h2>Milestones<br />worth sharing.</h2></div><div class="award-list">{funding.awards.map(a=><div class="award prose" set:html={localizeHtml(a.html.replace(/^<li>|<\/li>$/g,''))} />)}</div></div></section><section class="section wrap" id="sponsors"><div class="section-title"><div><p class="eyebrow">03 / Our sponsors</p><h2>Supporting our research.</h2></div></div><div class="sponsor-grid">{funding.sponsors.map(s=><figure><img src={thumb(s.image)} alt={s.name} width="190" height="110" loading="lazy" /><figcaption>{s.name}</figcaption></figure>)}</div></section></Layout>
<style>.funding-section{display:grid;grid-template-columns:1fr 1.7fr;gap:70px;padding-bottom:80px}.funding-heading h2,.awards-layout h2{font-size:2.65rem;line-height:1.16}.grant-group{margin-bottom:35px}.grant-group h3{font-size:.83rem;font-weight:700;color:var(--blue);letter-spacing:0;margin-bottom:21px}.grant{padding:20px 0;border-top:1px solid var(--line);font-size:.95rem;line-height:1.85}.grant :global(p),.award :global(p){margin:0}.awards-layout{display:grid;grid-template-columns:1fr 1.7fr;gap:70px}.award{padding:18px 0;border-top:1px solid #cbdde7;font-size:.91rem;line-height:1.8}.sponsor-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:30px}.sponsor-grid figure{margin:0;border-top:1px solid var(--line);padding-top:30px}.sponsor-grid img{height:85px;width:100%;object-fit:contain;padding:8px}.sponsor-grid figcaption{font-size:.76rem;color:var(--muted);text-align:center;margin-top:20px}@media(max-width:850px){.funding-section,.awards-layout{gap:35px;grid-template-columns:1fr 1.6fr}.funding-heading h2,.awards-layout h2{font-size:2.1rem}.sponsor-grid{grid-template-columns:repeat(3,1fr)}}@media(max-width:600px){.funding-section,.awards-layout{grid-template-columns:1fr;gap:30px}.funding-heading h2 br,.awards-layout h2 br{display:none}.grant{font-size:.89rem}.sponsor-grid{grid-template-columns:1fr 1fr;gap:28px}.sponsor-grid figure{padding-top:20px}.sponsor-grid img{height:65px}}
</style>
