---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import Arrow from '../components/Arrow.astro';
import { href, thumb, localizeHtml, site } from '../lib/site';
import people from '../data/people.json';
const leader = people.members[0];
const groups = [['PhD researcher','PhD researchers','phd'],['MSc student','MSc students','msc'],['Visitor','Visiting researchers','visitors']];
---
<Layout title="People" active="People" description="Meet the researchers, students and alumni of the Efficient Machine Intelligence lab at TU Delft.">
  <PageIntro eyebrow="The people behind EMI" title="A shared curiosity." description="Researchers, engineers and students working together at the intersection of machine learning and microelectronics." />
  <div class="wrap"><nav class="anchor-nav" aria-label="People sections"><a href="#leader">Group leader</a><a href="#phd">PhD researchers</a><a href="#msc">MSc students</a><a href="#visitors">Visitors</a><a href="#alumni">Alumni</a></nav></div>
  <section id="leader" class="wrap leader-section"><a href={leader.url} class="leader-photo"><img src={thumb(leader.image)} alt="Chang Gao" width="800" height="850" /></a><div class="leader-copy"><p class="eyebrow">Group leader</p><h2>Dr. Chang Gao <a href={leader.url} aria-label="Chang Gao's personal website"><Arrow diagonal size={25} /></a></h2><p class="leader-role">Assistant Professor of Edge AI</p><p>Department of Microelectronics<br />Faculty of Electrical Engineering, Mathematics and Computer Science<br />Delft University of Technology</p><p>Leading the EMI lab’s research in neuromorphic algorithm–hardware co-design for energy-efficient edge intelligence.</p><div class="profile-links"><a href={leader.url}>Personal website <Arrow diagonal size={14} /></a><a href={site.scholar}>Google Scholar <Arrow diagonal size={14} /></a><a href="https://www.linkedin.com/in/gaochangw">LinkedIn <Arrow diagonal size={14} /></a><a href={`mailto:${site.email}`}>Email <Arrow diagonal size={14} /></a></div></div></section>
  {groups.map(([role,label,id]) => <section class="wrap people-section" id={id}><div class="section-title"><h2>{label}<span class="count">{people.members.filter(p=>p.role===role).length}</span></h2>{id==='phd' && <a class="text-link" href={href('/join-us/')}>Research opportunities <Arrow /></a>}</div><div class="people-grid">{people.members.filter(p=>p.role===role).map(p=><article class="person" id={p.id}><a class="person-image" href={href(p.url)} aria-label={`View ${p.name}'s profile`}><img src={thumb(p.image)} alt={p.name} loading="lazy" width="800" height="900" /><span><Arrow diagonal /></span></a><h3><a href={href(p.url)}>{p.name}</a></h3><p class="person-role">{p.role}</p>{p.detail && <p class="person-detail">{p.detail}</p>}{p.links.length>1 && <div class="person-links">{p.links.slice(1).filter(l=>!l.label.match(/^\)$/)).map(l=><a href={href(l.url)}>{l.label.replace(/[()]/g,'')} <Arrow diagonal size={12} /></a>)}</div>}</article>)}</div></section>)}
  <section id="alumni" class="section-soft section"><div class="wrap"><div class="section-title"><div><p class="eyebrow">Where the journey continues</p><h2>MSc alumni<span class="count">{people.alumni.length}</span></h2></div></div><div class="alumni-layout"><div class="alumni-list">{people.alumni.map(a=><div class="alumni-row prose" set:html={localizeHtml(a.html.replace(/^<li>|<\/li>$/g,''))} />)}</div><figure><img src={thumb(people.alumniImage)} alt="MSc alumni of the EMI lab" width="800" height="600" loading="lazy" /><figcaption>Part of the EMI community, wherever life takes you.</figcaption></figure></div></div></section>
</Layout>
<style>
  .leader-section{display:grid;grid-template-columns:300px 1fr;gap:60px;align-items:center;padding-bottom:65px}.leader-photo{max-width:300px;display:block;background:var(--pale);border-radius:3px;overflow:hidden}.leader-photo img{width:100%;height:340px;object-fit:cover}.leader-copy h2{font-size:2.8rem;display:flex;align-items:center;gap:20px;margin-bottom:12px}.leader-copy h2 a{color:var(--muted)}.leader-role{font-size:1.07rem;color:var(--blue);font-weight:600;margin-bottom:18px}.leader-copy>p:not(.eyebrow):not(.leader-role){font-size:.9rem;color:var(--muted);line-height:1.85;max-width:600px}.profile-links{display:flex;flex-wrap:wrap;gap:12px 24px}.profile-links a{font-size:.77rem;font-weight:650;display:flex;align-items:center;gap:7px}.profile-links a:hover{color:var(--blue)}.people-section{padding-top:45px;padding-bottom:55px;border-top:1px solid var(--line)}.people-section h2{font-size:2rem}.people-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:38px 27px}.person-image{display:block;position:relative;aspect-ratio:1/1.08;background:var(--pale);border-radius:3px;overflow:hidden}.person-image img{width:100%;height:100%;object-fit:cover;object-position:50% 25%;transition:transform .3s}.person:hover .person-image img{transform:scale(1.025)}.person-image>span{position:absolute;bottom:12px;right:12px;width:30px;height:30px;display:grid;place-items:center;border-radius:50%;background:#fff}.person h3{margin:18px 0 6px;font-size:1.13rem;letter-spacing:-.02em}.person h3 a:hover{color:var(--blue)}.person-role{font-size:.77rem;color:var(--blue);margin-bottom:5px}.person-detail{font-size:.75rem;color:var(--muted);line-height:1.6;margin-bottom:5px}.person-links a{display:flex;align-items:center;gap:5px;font-size:.75rem;text-decoration:underline;color:var(--muted)}.alumni-layout{display:grid;grid-template-columns:1.3fr 1fr;gap:75px;align-items:start}.alumni-list{columns:2;column-gap:35px}.alumni-row{break-inside:avoid;font-size:.8rem;padding:11px 0;border-top:1px solid var(--line);line-height:1.7}.alumni-row :global(p){margin:0}.alumni-layout figure{margin:0}.alumni-layout img{border-radius:3px;width:100%;max-height:420px;object-fit:contain}.alumni-layout figcaption{font-size:.76rem;color:var(--muted);margin-top:14px}
  @media(max-width:900px){.leader-section{grid-template-columns:240px 1fr;gap:35px}.leader-photo img{height:290px}.leader-copy h2{font-size:2.3rem}.people-grid{grid-template-columns:repeat(3,1fr)}.alumni-layout{gap:35px;grid-template-columns:1fr 1fr}.alumni-list{columns:1}}
  @media(max-width:650px){.leader-section{grid-template-columns:1fr;gap:30px;padding-bottom:45px}.leader-photo{width:180px}.leader-photo img{height:210px}.leader-copy h2{font-size:2.1rem}.leader-copy>p:not(.eyebrow):not(.leader-role){font-size:.85rem}.people-grid{grid-template-columns:1fr 1fr;gap:30px 18px}.person h3{font-size:1rem}.person-detail{font-size:.75rem}.people-section h2{font-size:1.75rem}.people-section{padding:35px 0 45px}.alumni-layout{grid-template-columns:1fr}.alumni-list{columns:1}.alumni-row{font-size:.84rem}}
</style>
