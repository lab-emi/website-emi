---
import { href } from '../lib/site';
const destination = href('/join-us/#jobs');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Job opportunities — EMI Lab</title>
    <link rel="canonical" href={new URL(href('/join-us/'), Astro.site)} />
    <meta http-equiv="refresh" content={`0;url=${destination}`} />
    <meta name="robots" content="noindex" />
  </head>
  <body><p><a href={destination}>Continue to job opportunities at EMI</a></p></body>
</html>
