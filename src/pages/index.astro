---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Arrow from '../components/Arrow.astro';
import NewsCard from '../components/NewsCard.astro';
import { href, site, thumb } from '../lib/site';
import { changGao, labSchema, personSchema, jsonLd } from '../lib/identity';
import { research } from '../data/research';
import gallery from '../data/gallery.json';
import funding from '../data/funding.json';
import publications from '../data/publications.json';
import people from '../data/people.json';
const news = (await getCollection('news')).sort((a,b)=>b.data.date.getTime()-a.data.date.getTime());
// Show the new lab visit first, keeping the existing photo sequence after it.
// Fit the full group photo; position conference shots around the presenter.
const heroPhotos = [
  {
    image:'/images/chang-visit-anding-zhu-lab.webp',
    caption:"Chang's Visit to Prof. Anding Zhu's Lab",
    width:1024, height:768, position:'50% 50%', fit:'contain',
  },
  ...[
  { id:'photo-9', position:'50% 50%' }, // Chang and Chris
  { id:'photo-10', position:'50% 50%' }, // Yizhuo and Chris
  { id:'photo-3', position:'15% 50%' }, // Ang Li
  { id:'photo-4', position:'75% 50%' }, // Sjoerd Groot
  { id:'photo-5', position:'95% 50%' }, // Manno Versluis
  { id:'photo-6', position:'100% 50%' }, // Tao Han
  { id:'photo-7', position:'65% 50%' }, // Siddharth Patil
  { id:'photo-8', position:'45% 50%' }, // Arne de Beer
  { id:'photo-1', position:'50% 50%' }, // Yizhuo at IMS 2024
  { id:'photo-2', position:'50% 50%' }, // Yizhuo at IMS 2025
  ].map(({id,position})=>({...gallery.find(photo=>photo.id===id)!,position,fit:'cover'})),
];
const selected = ['OpenDPDv2:', 'BitFair:', 'Exploiting neuro-inspired'].map(prefix=>publications.find(p=>p.title.startsWith(prefix))!);
---
<Layout>
  <Fragment slot="head">
    <meta name="robots" content="index,follow,max-image-preview:large" />
    <script is:inline type="application/ld+json" set:html={jsonLd({
      '@context': 'https://schema.org',
      '@graph': [
        { '@type': 'WebSite', '@id': 'https://www.tudemi.com/#website', url: 'https://www.tudemi.com/', name: site.name, alternateName: site.fullName, publisher: { '@id': labSchema['@id'] } },
        labSchema,
        personSchema,
      ],
    })} />
  </Fragment>
  <section class="hero wrap">
    <div class="hero-copy">
      <p class="eyebrow"><span class="little-square"></span>TU Delft · Department of Microelectronics</p>
      <h1>Intelligence.<br /><em>Made efficient.</em></h1>
      <p class="hero-description">We design algorithms and hardware together to bring energy-efficient intelligence to the edge.</p>
      <p class="hero-name">Lab of Efficient Machine Intelligence</p>
      <div class="hero-actions"><a class="button" href={href('/research/')}>Explore our research <Arrow /></a><a class="text-link" href={href('/people/')}>Meet the lab <Arrow diagonal /></a></div>
      <div class="hero-foot"><span class="location-mark">Delft, the Netherlands</span><span>Algorithms ↔ Hardware</span></div>
    </div>
    <figure class="hero-photo" data-hero-carousel role="group" aria-roledescription="carousel" aria-label="Life at EMI">
      {heroPhotos.map((photo,index)=><img class:list={['hero-slide',{'is-active':index===0}]} src={href(photo.image)} alt={photo.caption} data-caption={photo.caption} style={{objectPosition:photo.position,objectFit:photo.fit}} width={photo.width} height={photo.height} loading={index===0?'eager':'lazy'} fetchpriority={index===0?'high':'low'} aria-hidden={index!==0} />)}
      <div class="photo-tag"><span class="tag-dot"></span>Inside EMI</div>
      <button type="button" class="hero-pause" data-carousel-toggle aria-label="Pause slideshow" title="Pause slideshow" hidden>
        <span data-pause-icon><svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M4 3h3v10H4zm5 0h3v10H9z" /></svg></span>
        <span data-play-icon hidden><svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="m5 2 9 6-9 6z" /></svg></span>
      </button>
      <figcaption aria-live="off"><span>Ideas, made tangible.</span><small data-carousel-caption>{heroPhotos[0].caption}</small><a href={href('/gallery/')} aria-label="Explore life at EMI"><Arrow diagonal /></a></figcaption>
    </figure>
  </section>
  <section class="research-section section-soft section">
    <div class="wrap"><div class="section-title"><div><p class="eyebrow">Our research</p><h2>From learning algorithms<br />to efficient silicon.</h2></div><p class="research-intro">Our work connects neuromorphic computing, signal processing and hardware design.</p></div>
    <div class="research-grid">{research.map(r=><article class="research-card"><a class="research-card-main" href={href(`/research/${r.id}/`)}><div class="research-card-top"><span>{r.number}</span><Arrow diagonal size={21} /></div><img class="research-card-image" src={href(r.image)} alt={r.imageAlt} width={r.imageWidth} height={r.imageHeight} loading="lazy" decoding="async" /><h3>{r.title}</h3><p>{r.description}</p><span class="research-tag">{r.keywords[0]}</span></a><a class="research-photo-credit" href={r.imageSource}>{r.imageCredit}<Arrow diagonal size={12} /></a></article>)}</div>
    <div class="open-source-callout">
      <div><h3>Explore our open-source research.</h3><p>Find code, datasets and pretrained models from EMI on GitHub.</p></div>
      <a class="button button-light" href={site.github}>Explore EMI on GitHub <Arrow diagonal size={18} /></a>
    </div></div>
  </section>
  <section class="section wrap">
    <div class="section-title"><div><p class="eyebrow">Latest from the lab</p><h2>News & perspectives.</h2></div><a class="text-link" href={href('/news/')}>All news <Arrow /></a></div>
    <div class="home-news">{news.slice(0,3).map(entry=><NewsCard entry={entry} />)}</div>
    <div class="news-ticker">{news.slice(3,6).map(entry=><a href={href(`/news/${entry.id}/`)}><span>{entry.data.date.getUTCFullYear()}</span><strong>{entry.data.title}</strong><Arrow diagonal size={17} /></a>)}</div>
  </section>
  <section class="selected-section section">
    <div class="wrap selected-layout"><div><p class="eyebrow">Selected publications</p><h2>Ideas worth<br /><em>building on.</em></h2><p>Explore our work in efficient AI, circuits, systems and sensing.</p><a class="text-link" href={href('/publications/')}>Browse publications <Arrow /></a></div><div class="selected-list">{selected.map((p,i)=><a href={p.url} class="selected-paper"><div class="selected-meta"><span>0{i+1}</span><span>{p.year} · {p.topic}</span><Arrow diagonal size={18} /></div><h3>{p.title}</h3><p>{p.authors}</p><span class="selected-venue">{i===0?'GLOBECOM · Accepted':i===1?'IEEE JETCAS':'Nature Communications'}</span></a>)}</div></div>
  </section>
  <section class="section wrap lab-section">
    <div class="lab-images"><img src={thumb(gallery[15].image)} alt={gallery[15].caption} width="800" height="600" loading="lazy" /><img src={thumb(gallery[11].image)} alt={gallery[11].caption} width="800" height="600" loading="lazy" /></div>
    <div class="lab-copy"><p class="eyebrow">People behind the research</p><h2>Good science.<br /><em>Shared curiosity.</em></h2><p>Led by <a href={changGao.url}>Dr. Chang Gao</a>, we are a team of researchers and students at TU Delft, working across machine learning, microelectronics and embedded systems.</p><div class="face-stack">{people.members.slice(0,5).map(p=><img src={thumb(p.image)} alt={p.name} width="48" height="48" loading="lazy" />)}<a href={href('/people/')} aria-label="Meet all members"><Arrow /></a></div><a class="text-link" href={href('/people/')}>Get to know us <Arrow /></a></div>
  </section>
  <section class="support-section wrap"><p class="eyebrow">Supported by</p><div class="sponsors">{funding.sponsors.map(s=><img src={thumb(s.image)} alt={s.name} loading="lazy" width="170" height="70" />)}</div><a class="support-link" href={href('/grants-awards/')}>Our grants, collaborations & awards <Arrow diagonal size={15} /></a></section>
  <section class="join-strip"><div class="wrap"><div><p class="eyebrow">Build with us</p><h2>Curious about what comes next?</h2><p>Explore MSc projects, research opportunities and collaborations.</p></div><a class="button" href={href('/join-us/')}>Find your place at EMI <Arrow diagonal /></a></div></section>
</Layout>
<script>
  import '../scripts/hero-carousel';
</script>
<style>
  .open-source-callout{display:flex;align-items:center;justify-content:space-between;gap:32px;margin-top:42px;padding:32px 36px;border-radius:4px;background:var(--ink);color:white}.open-source-callout>div{min-width:0}.open-source-callout h3{font-size:1.65rem;line-height:1.3;margin-bottom:10px}.open-source-callout p{font-size:1rem;line-height:1.7;color:#c3d3de;margin:0}.open-source-callout .button{flex-shrink:0;white-space:normal;text-align:center}.open-source-callout .button:focus-visible{outline-color:var(--cyan)}@media(max-width:800px){.open-source-callout{flex-direction:column;align-items:flex-start;gap:24px;padding:28px}}@media(max-width:550px){.open-source-callout{padding:25px 22px}.open-source-callout h3{font-size:1.45rem}.open-source-callout .button{width:100%;gap:12px}}
  .research-card-main{display:flex;flex:1;flex-direction:column;min-width:0}.research-photo-credit{display:flex;align-items:flex-start;gap:5px;width:fit-content;max-width:100%;margin-top:17px;font-size:.75rem;line-height:1.6;color:var(--muted)}.research-photo-credit svg{flex-shrink:0;margin-top:3px}.research-photo-credit:hover{color:var(--blue);text-decoration:underline;text-underline-offset:3px}
  .hero-photo>.hero-slide{position:absolute;inset:0;opacity:0;transition:opacity .45s ease}.hero-photo>.hero-slide.is-active{opacity:1}.hero-pause{position:absolute;z-index:2;top:20px;right:20px;width:34px;height:34px;padding:0;display:grid;place-items:center;border:0;border-radius:2px;background:#fff;color:var(--ink)}.hero-pause>span{display:flex}.hero-pause:hover{background:var(--pale)}
  .lab-copy>p a{color:var(--blue);text-decoration:underline;text-underline-offset:3px}
  .hero{display:grid;grid-template-columns:1.12fr 1fr;gap:60px;padding-top:63px;padding-bottom:69px;align-items:center}.hero h1{font-size:clamp(3.5rem,5.8vw,5.8rem);line-height:1.02;letter-spacing:-.065em;margin:27px 0 25px}.hero h1 em{font-family:var(--serif);font-weight:400;color:var(--blue);letter-spacing:-.045em}.hero .eyebrow{font-size:.75rem;letter-spacing:.095em;line-height:1.7}.hero-description{font-size:1.14rem;color:var(--muted);line-height:1.8;max-width:450px;margin-bottom:12px}.hero-name{font-size:.77rem;font-weight:650;color:var(--ink);margin-bottom:29px}.hero-actions{display:flex;gap:28px;align-items:center}.hero-foot{display:flex;gap:28px;align-items:center;border-top:1px solid var(--line);padding-top:25px;margin-top:40px;font-size:.75rem;color:var(--muted)}.hero-foot span:last-child{letter-spacing:.015em}.location-mark:before{content:'+';margin-right:8px;color:var(--blue)}.hero-photo{position:relative;margin:0;height:530px;background:var(--pale);border-radius:4px;overflow:hidden}.hero-photo>img{width:100%;height:100%;object-fit:cover;object-position:50% 50%}.hero-photo:after{content:'';position:absolute;inset:45% 0 0;background:linear-gradient(transparent,rgba(7,19,30,.87));pointer-events:none}.photo-tag{position:absolute;top:20px;left:20px;display:flex;align-items:center;gap:8px;font-size:.75rem;font-weight:650;padding:7px 12px;background:#fff;border-radius:2px}.tag-dot{height:5px;width:5px;background:var(--blue);border-radius:50%}.hero-photo figcaption{position:absolute;z-index:1;bottom:27px;left:28px;right:28px;color:white;padding-right:35px}.hero-photo figcaption>span{font-size:1.8rem;line-height:1.3;font-weight:500;letter-spacing:-.035em}.hero-photo small{display:block;font-size:.75rem;color:#e0eaf0;margin-top:7px;max-width:280px;line-height:1.6}.hero-photo figcaption a{position:absolute;right:0;bottom:5px;border:1px solid #8a9ca7;display:grid;place-items:center;width:33px;height:33px;border-radius:50%}.research-intro{max-width:330px;font-size:.92rem;color:var(--muted);margin-bottom:3px}.research-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:0;border-top:1px solid #cedee7}.research-card{display:flex;flex-direction:column;padding:26px 25px 5px 0;min-width:0}.research-card-image{display:block;width:100%;height:auto;aspect-ratio:3/2;object-fit:cover;background:#e7f2f7;border-radius:4px;margin:0 0 24px}.research-card+.research-card{padding-left:25px;border-left:1px solid #cedee7}.research-card-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;color:var(--blue);font-size:.75rem}.research-card-top svg{transition:transform .2s}.research-card:hover .research-card-top svg{transform:translate(3px,-3px)}.research-card h3{font-size:1.27rem;min-height:4.05em;letter-spacing:-.03em;line-height:1.35;margin-bottom:14px}.research-card p{flex:1;font-size:.875rem;color:var(--muted);line-height:1.8;margin-bottom:25px;min-height:7em}.research-tag{align-self:flex-start;font-size:.75rem;color:var(--blue);font-weight:650;border-bottom:1px solid #bfd9e6;padding-bottom:5px}.home-news{display:grid;grid-template-columns:repeat(3,1fr);gap:30px}.news-ticker{display:grid;grid-template-columns:repeat(3,1fr);gap:30px;border-top:1px solid var(--line);margin-top:34px;padding-top:23px}.news-ticker a{display:flex;gap:15px;align-items:start;font-size:.77rem;line-height:1.65}.news-ticker span{font-size:.75rem;color:var(--muted);padding-top:2px}.news-ticker strong{font-weight:550;flex:1}.news-ticker svg{margin-top:4px}.news-ticker a:hover strong{color:var(--blue)}.selected-section{background:var(--ink);color:#fff}.selected-layout{display:grid;grid-template-columns:.8fr 1.5fr;gap:100px}.selected-section .eyebrow{color:#80cce8}.selected-section h2{font-size:clamp(2.5rem,4vw,4rem);line-height:1.1}.selected-section h2 em{font-family:var(--serif);font-weight:400;color:#83d4ef}.selected-layout>div>p:not(.eyebrow){font-size:.92rem;max-width:290px;color:#b4c4d2;line-height:1.8}.selected-section .text-link{border-color:#43556a;margin-top:14px}.selected-section .text-link:hover{color:#83d4ef}.selected-paper{display:block;border-top:1px solid #3b4b5c;padding:24px 0}.selected-paper:last-child{padding-bottom:0}.selected-meta{display:flex;align-items:center;gap:20px;color:#a9c3d6;font-size:.75rem;margin-bottom:13px}.selected-meta span:first-child{color:#65c4e9}.selected-meta svg{margin-left:auto}.selected-paper h3{font-size:1.25rem;line-height:1.45;letter-spacing:-.02em;margin-bottom:10px}.selected-paper:hover h3{color:#89d4ef}.selected-paper p{font-size:.75rem;line-height:1.7;color:#a5b8c7;margin-bottom:9px}.selected-venue{font-size:.75rem;font-weight:600;color:#d3e8f3}.lab-section{display:grid;grid-template-columns:1.25fr 1fr;gap:90px;align-items:center}.lab-images{display:grid;grid-template-columns:1fr 1fr;gap:17px;align-items:center}.lab-images img{width:100%;height:340px;object-fit:cover;border-radius:3px}.lab-images img:last-child{height:290px;margin-top:70px}.lab-copy h2{line-height:1.15}.lab-copy h2 em{font-family:var(--serif);font-weight:400;color:var(--blue)}.lab-copy>p:not(.eyebrow){font-size:.94rem;line-height:1.9;color:var(--muted)}.face-stack{display:flex;margin:24px 0 18px;padding-left:8px}.face-stack img,.face-stack a{border-radius:50%;width:43px;height:43px;border:3px solid white;object-fit:cover;margin-left:-8px;background:var(--pale)}.face-stack a{display:grid;place-items:center;margin-left:4px}.support-section{padding-bottom:75px;text-align:center}.support-section .eyebrow{justify-content:center}.sponsors{display:flex;align-items:center;justify-content:space-evenly;gap:45px;margin:30px 0 25px}.sponsors img{max-width:155px;height:58px;object-fit:contain;mix-blend-mode:multiply}.support-link{display:inline-flex;align-items:center;gap:8px;color:var(--muted);font-size:.75rem}.support-link:hover{color:var(--blue)}.join-strip{background:#e7f4f9;padding-block:49px;border-top:1px solid #d3e9f3}.join-strip .wrap{display:flex;justify-content:space-between;gap:30px;align-items:center}.join-strip .eyebrow{margin-bottom:12px}.join-strip h2{font-size:1.9rem;margin-bottom:10px}.join-strip p:last-child{font-size:.87rem;color:var(--muted);margin:0}
  @media(min-width:1600px){.hero-photo{height:580px}.hero h1{font-size:6.3rem}}
  @media(max-width:1100px){.hero{gap:30px}.hero-photo{height:480px}.hero-actions{gap:15px}.hero-description{font-size:1.02rem}.hero .button{font-size:.8rem;padding:13px 16px}.hero-actions .text-link{font-size:.8rem}.research-card{padding-right:16px}.research-card+.research-card{padding-left:16px}.research-card h3{font-size:1.12rem}.research-card p{font-size:.875rem}.selected-layout{gap:50px}.lab-section{gap:45px}.sponsors{gap:25px}.sponsors img{max-width:130px}}
  @media(max-width:800px){.hero{grid-template-columns:1fr;padding-top:44px;padding-bottom:50px;gap:35px}.hero h1{font-size:5rem}.hero-description{max-width:550px}.hero-photo{height:430px}.hero-foot{margin-top:29px;padding-top:20px}.research-grid{grid-template-columns:1fr 1fr;gap:35px 0}.research-card:nth-child(3){padding-left:0;border-left:0}.research-card h3{font-size:1.3rem;min-height:3em}.research-card p{font-size:.875rem;min-height:5.8em}.research-intro{max-width:100%}.selected-layout{grid-template-columns:1fr;gap:35px}.selected-layout>div>p:not(.eyebrow){max-width:450px}.selected-layout h2 br{display:none}.home-news{gap:18px}.news-ticker{gap:18px}.lab-section{gap:30px}.lab-images img{height:280px}.lab-images img:last-child{height:230px}.sponsors{flex-wrap:wrap;gap:25px 40px}.join-strip .wrap{align-items:start;flex-direction:column}}
  @media(max-width:650px){.hero h1{font-size:clamp(3.2rem,12vw,4.5rem)}.hero .eyebrow{font-size:.75rem;letter-spacing:.05em}.hero-description{font-size:1rem}.hero-photo{height:370px}.hero-photo figcaption{left:22px;bottom:24px}.hero-photo figcaption>span{font-size:1.6rem}.hero-foot{font-size:.75rem;gap:20px}.hero-actions{gap:22px}.hero-actions .text-link{font-size:.78rem}.research-grid{gap:28px 0}.research-card{padding-top:20px;padding-right:17px}.research-card+.research-card{padding-left:17px}.research-card:nth-child(3){padding-left:0}.research-card-top{margin-bottom:20px}.research-card h3{font-size:1.05rem;line-height:1.4;min-height:4.2em}.research-card p{font-size:.875rem;min-height:9em;margin-bottom:15px}.research-tag{font-size:.75rem}.home-news{grid-template-columns:1fr;gap:35px}.news-ticker{grid-template-columns:1fr;gap:16px}.news-ticker a{font-size:.85rem}.lab-section{grid-template-columns:1fr;gap:40px}.lab-images img{height:250px}.lab-images img:last-child{height:220px;margin-top:25px}.lab-copy h2{font-size:2.3rem}.support-section{padding-bottom:47px}.sponsors img{max-width:110px;height:48px}.sponsors{gap:30px}.join-strip h2{font-size:1.8rem}.selected-paper h3{font-size:1.15rem}}
  @media(max-width:550px){.research-grid{grid-template-columns:1fr;gap:28px}.research-card,.research-card+.research-card{padding:24px 0 0;border-left:0}.research-card+.research-card{border-top:1px solid #cedee7}.research-card-top{margin-bottom:16px}.research-card-image{margin-bottom:22px}.research-card h3{font-size:1.2rem;min-height:0}.research-card p{font-size:.9rem;min-height:0;margin-bottom:20px}}
</style>
