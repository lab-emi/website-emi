---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Arrow from '../components/Arrow.astro';
import NewsCard from '../components/NewsCard.astro';
import VisitorMap from '../components/VisitorMap.astro';
import ResearchExplorer from '../components/ResearchExplorer.astro';
import TeamSection from '../components/TeamSection.astro';
import HomeChapterNav from '../components/HomeChapterNav.astro';
import '../styles/home-story.css';
import { href, site, thumb, dateLabel } from '../lib/site';
import { labSchema, personSchema, jsonLd } from '../lib/identity';
import gallery from '../data/gallery.json';
import funding from '../data/funding.json';
import publications from '../data/publications.json';
const news = (await getCollection('news')).sort((a,b)=>b.data.date.getTime()-a.data.date.getTime());
const latestNews = news[0];
// Show the new lab visit first, keeping the existing photo sequence after it.
// Fit the full group photo; position conference shots around the presenter.
const heroPhotos = [
  {
    image:'/images/chang-visit-anding-zhu-lab.webp',
    caption:"Chang's Visit to Prof. Anding Zhu's Lab",
    width:1024, height:768, position:'50% 50%', fit:'contain',
  },
  ...[
  { id:'photo-9', position:'50% 50%' }, // Chang and Chris
  { id:'photo-10', position:'50% 50%' }, // Yizhuo and Chris
  { id:'photo-3', position:'15% 50%' }, // Ang Li
  { id:'photo-4', position:'75% 50%' }, // Sjoerd Groot
  { id:'photo-5', position:'95% 50%' }, // Manno Versluis
  { id:'photo-6', position:'100% 50%' }, // Tao Han
  { id:'photo-7', position:'65% 50%' }, // Siddharth Patil
  { id:'photo-8', position:'45% 50%' }, // Arne de Beer
  { id:'photo-1', position:'50% 50%' }, // Yizhuo at IMS 2024
  { id:'photo-2', position:'50% 50%' }, // Yizhuo at IMS 2025
  ].map(({id,position})=>({...gallery.find(photo=>photo.id===id)!,position,fit:'cover'})),
];
const selected = ['OpenDPDv2:', 'BitFair:', 'Exploiting neuro-inspired'].map(prefix=>publications.find(p=>p.title.startsWith(prefix))!);
---
<Layout home>
  <Fragment slot="head">
    <meta name="robots" content="index,follow,max-image-preview:large" />
    <script is:inline type="application/ld+json" set:html={jsonLd({
      '@context': 'https://schema.org',
      '@graph': [
        { '@type': 'WebSite', '@id': 'https://www.tudemi.com/#website', url: 'https://www.tudemi.com/', name: site.name, alternateName: site.fullName, publisher: { '@id': labSchema['@id'] } },
        labSchema, personSchema,
      ],
    })} />
  </Fragment>
  <HomeChapterNav />
  <section id="research" class="research-first" data-story-section="Research" aria-labelledby="hero-heading">
    <div class="wrap">
      <div class="research-first-intro">
        <div class="research-intro-title"><h1 id="hero-heading">Energy-Efficient <span>Artificial Intelligence</span></h1><p class="research-context">TU Delft · Department of Microelectronics</p></div>
        {latestNews && <a class="latest-news-spotlight" href={href(`/news/${latestNews.id}/`)} aria-label={`Latest news: ${latestNews.data.title}`}>
          <span class="latest-news-head"><span><span class="status-light"></span> Latest news</span><time datetime={latestNews.data.date.toISOString()}>{dateLabel(latestNews.data.date)}</time></span>
          <strong>{latestNews.data.title}</strong><Arrow diagonal size={17} />
        </a>}
      </div>
      <div class="research-first-heading"><h2><span class="section-index">01 /</span> Inside the research</h2><p>Select a module. Explore the ideas inside. <span aria-hidden="true">↙</span></p></div>
      <ResearchExplorer compact />
      <div class="research-footnote"><span><span class="status-light"></span> Five directions. One shared pursuit of efficiency.</span><a class="text-link" href={href('/research/')}>All research & demonstrations <Arrow /></a></div>
    </div>
  </section>
  <TeamSection photos={heroPhotos} />
  <section id="open-source" class="section open-lab-section" data-story-section="Open source" aria-labelledby="open-heading">
    <div class="wrap open-lab-layout">
      <div data-reveal><p class="eyebrow"><span class="section-index">03 /</span> Open by design</p><h2 id="open-heading">Built to be<br /><em>built upon.</em></h2><p>Ideas go further when we share them. Explore our code, datasets and pretrained models, and make the next connection.</p><a class="button button-light" href={site.github}>Explore EMI on GitHub <Arrow diagonal /></a></div>
      <div class="open-project-stack">
        <a class="open-project-link" data-reveal href="https://github.com/lab-emi/RustSys"><span class="project-symbol" aria-hidden="true">⚙</span><div><span class="repo-kicker">AI-NATIVE RTL SYNTHESIS</span><h3>RustSys</h3><p>Fast Verilog/SystemVerilog synthesis in Rust for terminals, CI and coding agents.</p></div><Arrow diagonal /></a>
        <a class="open-project-link" data-reveal href="https://github.com/lab-emi/OpenDPD"><span class="project-symbol" aria-hidden="true">∿</span><div><span class="repo-kicker">LEARNING BETTER SIGNALS</span><h3>OpenDPD</h3><p>From neural models to better radio transmitters.</p></div><Arrow diagonal /></a>
        <a class="open-project-link" data-reveal href="https://github.com/lab-emi/GrainSpeech"><span class="project-symbol" aria-hidden="true">◈</span><div><span class="repo-kicker">COMPACT SPEECH SYNTHESIS</span><h3>GrainSpeech</h3><p>Finer acoustic detail in a 264.8K-parameter speech model.</p></div><Arrow diagonal /></a>
        <a class="open-project-link" data-reveal href="https://github.com/lab-emi/CleanUMamba"><span class="project-symbol" aria-hidden="true">≋</span><div><span class="repo-kicker">LISTENING WITH LESS</span><h3>CleanUMamba</h3><p>Efficient speech denoising with state-space models.</p></div><Arrow diagonal /></a>
        <a class="open-project-link" data-reveal href="https://github.com/lab-emi/AIRHAR"><span class="project-symbol" aria-hidden="true">⌁</span><div><span class="repo-kicker">SENSING EVERYDAY ACTIVITY</span><h3>AIRHAR</h3><p>Connecting radar signals to human activity.</p></div><Arrow diagonal /></a>
      </div>
    </div>
  </section>
  <section id="news" class="section wrap news-section" data-story-section="News" aria-labelledby="news-heading">
    <div class="section-title" data-reveal><div><p class="eyebrow"><span class="section-index">04 /</span> Fresh from the lab</p><h2 id="news-heading">Always in motion.</h2></div><a class="text-link" href={href('/news/')}>All news <Arrow /></a></div>
    <div class="home-news">{news.slice(0,3).map(entry=><div data-reveal><NewsCard entry={entry} /></div>)}</div>
    <div class="news-ticker">{news.slice(3,6).map(entry=><a href={href(`/news/${entry.id}/`)}><span>{entry.data.date.getUTCFullYear()}</span><strong>{entry.data.title}</strong><Arrow diagonal size={17} /></a>)}</div>
  </section>
  <section id="selected-publications" class="section selected-section" data-story-section="Publications" aria-labelledby="selected-heading">
    <div class="wrap selected-layout">
      <div data-reveal><p class="eyebrow"><span class="section-index">05 /</span> Selected publications</p><h2 id="selected-heading">An idea.<br />An experiment.<br /><em>A step forward.</em></h2><p>Research in efficient AI, circuits, systems and sensing.</p><a class="text-link" href={href('/publications/')}>Browse all publications <Arrow /></a></div>
      <div class="selected-list">{selected.map((p,i)=><a href={href(p.url)} class="selected-paper" data-reveal><div class="selected-meta"><span>0{i+1} /</span><span>{p.year} · {p.topic}</span><Arrow diagonal size={20} /></div><h3>{p.title}</h3><p>{p.authors}</p><span class="selected-venue">{i===0?'GLOBECOM · Accepted':i===1?'IEEE JETCAS':'Nature Communications'}</span></a>)}</div>
    </div>
  </section>
  <section id="connect" class="home-connect" data-story-section="Connect" aria-label="Work with EMI">
  <section class="support-section wrap" aria-label="Research supporters"><p class="eyebrow">Shared ambition. Real support.</p><div class="sponsors">{funding.sponsors.map(s=><img src={thumb(s.image)} alt={s.name} loading="lazy" width="170" height="70" />)}</div><a class="support-link" href={href('/grants-awards/')}>Grants, collaborations & awards <Arrow diagonal size={15} /></a></section>
  <section class="join-strip"><div class="wrap"><div data-reveal><p class="eyebrow">Make your next connection</p><h2>What will <em>you</em> bring?</h2><p>Fresh questions. Different perspectives. Your next big idea.</p></div><a class="button" href={href('/join-us/')}>Find your place at EMI <Arrow diagonal /></a><svg class="join-orbit" viewBox="0 0 330 220" fill="none" aria-hidden="true"><ellipse cx="165" cy="110" rx="145" ry="55" transform="rotate(-28 165 110)" /><ellipse cx="165" cy="110" rx="145" ry="55" transform="rotate(28 165 110)" /><ellipse cx="165" cy="110" rx="145" ry="55" transform="rotate(90 165 110)" /></svg></div></section>
  </section>
  <VisitorMap />
</Layout>
<script>
  import '../scripts/hero-carousel';
  import '../scripts/home-story';
</script>
