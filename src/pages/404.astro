---
import Layout from '../layouts/Layout.astro';
import Arrow from '../components/Arrow.astro';
import { href } from '../lib/site';
---
<Layout title="Page not found"><meta slot="head" name="robots" content="noindex" /><section class="wrap not-found"><p class="eyebrow">404 · Page not found</p><h1>Let’s get you<br />back on track.</h1><p>The page may have moved. Explore our research, meet the lab or catch up on the latest news.</p><div><a class="button" href={href('/')}>Back to EMI <Arrow /></a><a class="text-link" href={href('/research/')}>Our research <Arrow diagonal /></a></div></section></Layout>
<style>.not-found{padding-block:85px 110px}.not-found h1{margin-bottom:25px}.not-found>p:not(.eyebrow){max-width:580px;line-height:1.8;color:var(--muted)}.not-found>div{display:flex;gap:28px;flex-wrap:wrap;align-items:center;margin-top:35px}</style>
