---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import Publication from '../components/Publication.astro';
import Arrow from '../components/Arrow.astro';
import publications from '../data/publications.json';
import { site } from '../lib/site';
const years=[...new Set(publications.map(p=>p.year))].sort((a,b)=>b-a);
const topics=[...new Set(publications.map(p=>p.topic))];
---
<Layout title="Publications" active="Publications" description="Explore EMI publications and patents in efficient machine intelligence, neuromorphic computing, digital predistortion and edge AI hardware.">
  <PageIntro eyebrow="Research outputs · 2017–2026" title="Publications." description="Algorithms, architectures and systems for efficient intelligence. Explore our papers, preprints and patents."><a class="text-link" href={site.scholar}>Google Scholar <Arrow diagonal /></a></PageIntro>
  <section class="wrap publications-section"><div class="filter-bar"><label class="search-field"><span class="sr-only">Search publications by title, author or venue</span><svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" stroke="currentColor" stroke-width="1.6" /><path d="m16 16 5 5" stroke="currentColor" stroke-width="1.6" /></svg><input id="pub-search" type="search" placeholder="Search by title, author or venue…" autocomplete="off" /></label><label><span class="sr-only">Publication year</span><select id="pub-year"><option value="">All years</option>{years.map(y=><option value={y}>{y}</option>)}</select></label><label><span class="sr-only">Research topic</span><select id="pub-topic"><option value="">All research areas</option>{topics.map(t=><option value={t}>{t}</option>)}</select></label></div><div class="publication-topline"><p id="pub-count" class="filter-summary" aria-live="polite">{publications.length} research outputs</p><p>EMI authors in bold · * Equal contribution</p></div><div class="publications-layout"><nav class="year-nav" aria-label="Publication years">{years.map(y=><a href={`#year-${y}`} data-year-link={y}>{y}<span>{publications.filter(p=>p.year===y).length}</span></a>)}</nav><div><p class="empty-state" id="pub-empty" hidden>No publications match these filters. <button id="pub-clear" type="button">Clear filters</button></p>{years.map(year=><section class="year-section" id={`year-${year}`} data-year-group={year}><h2>{year}<span class="year-rule"></span></h2>{publications.filter(p=>p.year===year).map(publication=><Publication publication={publication} />)}</section>)}</div></div></section>
  <script>
    const search=document.querySelector<HTMLInputElement>('#pub-search')!;
    const year=document.querySelector<HTMLSelectElement>('#pub-year')!;
    const topic=document.querySelector<HTMLSelectElement>('#pub-topic')!;
    const entries=[...document.querySelectorAll<HTMLElement>('[data-publication]')];
    const groups=[...document.querySelectorAll<HTMLElement>('[data-year-group]')];
    const initial=new URLSearchParams(location.search).get('topic');
    if(initial&&[...topic.options].some(o=>o.value===initial))topic.value=initial;
    function filter(){ const words=search.value.trim().toLowerCase().split(/\s+/).filter(Boolean); let count=0;
      entries.forEach(entry=>{entry.hidden=!words.every(w=>entry.dataset.search?.includes(w)) || Boolean(year.value&&entry.dataset.year!==year.value) || Boolean(topic.value&&entry.dataset.topic!==topic.value);if(!entry.hidden)count++;});
      groups.forEach(group=>{ const matches=[...group.querySelectorAll<HTMLElement>('[data-publication]')].filter(e=>!e.hidden).length;group.hidden=matches===0;const a=document.querySelector<HTMLElement>(`[data-year-link="${group.dataset.yearGroup}"]`);if(a){a.hidden=!matches;a.querySelector('span')!.textContent=String(matches);} });
      document.querySelector('#pub-count')!.textContent=`${count} research ${count===1?'output':'outputs'}`;document.querySelector<HTMLElement>('#pub-empty')!.hidden=count>0;
    }
    search.addEventListener('input',filter);year.addEventListener('change',filter);topic.addEventListener('change',filter);
    document.querySelector('#pub-clear')?.addEventListener('click',()=>{search.value=year.value=topic.value='';filter();search.focus();});filter();
    // Optional browser agent interface: uses the same controls and filtering action.
    const context=(document as Document & {modelContext?:{registerTool:(tool:Record<string,unknown>,options:{signal:AbortSignal})=>void|Promise<void>}}).modelContext;
    if(context?.registerTool){
      const lifecycle=new AbortController();
      window.addEventListener('pagehide',()=>lifecycle.abort(),{once:true});
      try { Promise.resolve(context.registerTool({
        name:'filter_publications', title:'Filter EMI publications',
        description:'Filter the visible publications by search terms, year and research area, and return matching citations. This updates the page filters.',
        inputSchema:{type:'object',properties:{query:{type:'string'},year:{type:'string'},topic:{type:'string'}},additionalProperties:false},
        annotations:{readOnlyHint:false,untrustedContentHint:true},
        execute(input:unknown){
          if(!input||typeof input!=='object'||Array.isArray(input))throw new Error('Expected a filters object.');
          const args=input as Record<string,unknown>;
          if(Object.keys(args).some(k=>!['query','year','topic'].includes(k))||Object.values(args).some(v=>typeof v!=='string'))throw new Error('Filters must contain only query, year and topic strings.');
          const selectedYear=(args.year as string)||'',selectedTopic=(args.topic as string)||'';
          if(![...year.options].some(o=>o.value===selectedYear)||![...topic.options].some(o=>o.value===selectedTopic))throw new Error('Unknown year or research topic.');
          search.value=(args.query as string)||'';year.value=selectedYear;topic.value=selectedTopic;filter();
          const results=entries.filter(e=>!e.hidden).map(e=>({title:e.querySelector('h3')?.textContent?.trim(),year:Number(e.dataset.year),topic:e.dataset.topic,citation:e.querySelector('.citation-text')?.textContent?.trim(),url:e.querySelector('h3 a')?.getAttribute('href')||null}));
          return {count:results.length,results};
        },
      },{signal:lifecycle.signal})).catch(()=>{}); } catch { /* Browsers without the proposed API use the normal controls. */ }
    }
    document.querySelectorAll<HTMLButtonElement>('[data-copy-citation]').forEach(button=>button.addEventListener('click',async()=>{try{await navigator.clipboard.writeText(button.dataset.copyCitation!);button.textContent='Copied';setTimeout(()=>button.textContent='Copy citation',2000);}catch{const details=button.closest('article')?.querySelector('details');if(details){details.open=true;details.querySelector<HTMLElement>('.citation-text')?.scrollIntoView({block:'nearest'});}button.textContent='Select the citation below';}}));
  </script>
</Layout>
<style>.publications-section{padding-bottom:80px}.publication-topline{display:flex;justify-content:space-between;align-items:center;gap:20px;margin-bottom:38px}.publication-topline>p:last-child{font-size:.75rem;color:var(--muted);margin:0}.publications-layout{display:grid;grid-template-columns:125px 1fr;gap:75px}.year-nav{position:sticky;top:118px;align-self:start}.year-nav a{display:flex;align-items:center;justify-content:space-between;gap:20px;font-size:.87rem;font-weight:550;padding:8px 14px 8px 0;color:var(--muted)}.year-nav a:hover{color:var(--blue)}.year-nav span{font-size:.75rem;color:#84909b}.year-section{margin-bottom:45px;scroll-margin-top:115px}.year-section h2{font-size:1.8rem;display:flex;align-items:center;gap:25px;margin-bottom:24px}.year-rule{height:1px;background:var(--line);flex:1}.year-section :global(.publication:first-of-type){border-top:0;padding-top:0}#pub-clear{background:none;border:0;color:var(--blue);text-decoration:underline;padding:0}@media(max-width:900px){.publications-layout{grid-template-columns:85px 1fr;gap:35px}}@media(max-width:650px){.publications-layout{grid-template-columns:1fr}.year-nav{display:none}.publication-topline{align-items:start;flex-direction:column;gap:8px;margin-bottom:30px}.filter-bar{margin-bottom:23px}.filter-bar label:has(select){flex:1}.filter-bar select{width:100%}.year-section h2{font-size:1.6rem}}</style>
