---
import Arrow from './Arrow.astro';
import PrincipalInvestigator from './PrincipalInvestigator.astro';
import people from '../data/people.json';
import { href, thumb } from '../lib/site';
interface Photo { image: string; caption: string; width: number; height: number; position?: string; fit?: string; }
interface Props { photos: Photo[]; }
const { photos } = Astro.props;
---
<section id="team" class="section home-team-section home-team-combined" data-story-section="The team & PI" data-team-section aria-labelledby="people-heading">
  <div class="wrap home-people">
    <div class="team-collage">
      <figure class="team-photo team-photo-side team-photo-left"><img src={href(photos[1].image)} alt={photos[1].caption} width={photos[1].width} height={photos[1].height} loading="lazy" /></figure>
      <figure class="team-photo team-photo-side team-photo-right"><img src={href(photos[3].image)} alt={photos[3].caption} width={photos[3].width} height={photos[3].height} loading="lazy" /></figure>
      <figure class="hero-photo team-photo team-photo-main" data-hero-carousel role="group" aria-roledescription="carousel" aria-label="Life at EMI">
        {photos.map((photo,index)=><img class:list={['hero-slide',{'is-active':index===0}]} src={href(photo.image)} alt={photo.caption} data-caption={photo.caption} style={{objectPosition:photo.position,objectFit:photo.fit}} width={photo.width} height={photo.height} loading="lazy" aria-hidden={index!==0} />)}
        <div class="photo-tag"><span class="status-light"></span> LIFE, IN GOOD COMPANY</div>
        <button type="button" class="hero-pause" data-carousel-toggle aria-label="Pause slideshow" title="Pause slideshow" hidden><span data-pause-icon>Ⅱ</span><span data-play-icon hidden>▷</span></button>
        <div class="photo-controls"><button type="button" data-carousel-previous aria-label="Previous photo" hidden>←</button><button type="button" data-carousel-next aria-label="Next photo" hidden>→</button></div>
        <figcaption><span data-carousel-caption>{photos[0].caption}</span><a href={href('/gallery/')} aria-label="Explore life at EMI"><Arrow diagonal /></a></figcaption>
      </figure>
    </div>
    <div class="people-copy team-copy">
      <div class="team-intro"><p class="eyebrow"><span class="section-index">02 /</span> The people behind EMI</p><h2 id="people-heading">Meet our team.</h2><p>Efficient AI, built together at TU Delft.</p></div>
      <PrincipalInvestigator embedded />
      <div class="team-links"><div class="face-stack">{people.members.slice(0,5).map((p,i)=><img src={thumb(p.image)} alt={p.name} width="48" height="48" loading="lazy" style={`--face-index:${i}`} />)}</div><a class="text-link" href={href('/people/')}>Meet everyone <Arrow /></a></div>
    </div>
  </div>
</section>
