---
import type { CollectionEntry } from 'astro:content';
import { href, thumb, dateLabel } from '../lib/site';
import Arrow from './Arrow.astro';
interface Props { entry: CollectionEntry<'news'>; }
const { entry } = Astro.props;
---
<article class="news-card">
  <a class="news-picture" href={href(`/news/${entry.id}/`)} tabindex="-1" aria-hidden="true"><img src={thumb(entry.data.image)} alt="" loading="lazy" width="800" height="550" /><span class="picture-arrow"><Arrow diagonal /></span></a>
  <div class="news-meta"><span>{entry.data.category}</span><time datetime={entry.data.date.toISOString()}>{dateLabel(entry.data.date)}</time></div>
  <h3><a href={href(`/news/${entry.id}/`)}>{entry.data.title}</a></h3>
  <p>{entry.data.summary}</p>
</article>
<style>
  .news-card{min-width:0}.news-picture{display:block;position:relative;aspect-ratio:1.55;overflow:hidden;background:var(--pale);border-radius:3px}.news-picture img{width:100%;height:100%;object-fit:cover;transition:transform .35s}.news-card:hover img{transform:scale(1.03)}.picture-arrow{position:absolute;bottom:12px;right:12px;width:36px;height:36px;background:white;display:grid;place-items:center;border-radius:50%}.news-meta{display:flex;align-items:center;justify-content:space-between;gap:12px;font-size:.75rem;color:var(--muted);margin:20px 0 12px}.news-meta span{color:var(--blue);font-weight:700}.news-card h3{font-size:1.13rem;letter-spacing:-.025em;line-height:1.4;margin-bottom:12px}.news-card h3 a:hover{color:var(--blue)}.news-card p{font-size:.84rem;color:var(--muted);line-height:1.75;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden;margin-bottom:0}
</style>
