---
interface Props { eyebrow?: string; title: string; description?: string; }
const { eyebrow, title, description } = Astro.props;
---
<section class="page-intro wrap">
  {eyebrow && <p class="eyebrow"><span class="little-square"></span>{eyebrow}</p>}
  <div class="intro-line"><h1>{title}</h1><slot /></div>
  {description && <p class="intro-description">{description}</p>}
</section>
