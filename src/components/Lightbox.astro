<dialog class="lightbox" aria-label="Image viewer">
  <button type="button" class="lightbox-close" aria-label="Close image viewer">×</button>
  <div class="lightbox-image-wrap"><img class="lightbox-image" alt="" hidden /></div>
  <div class="lightbox-bottom"><button type="button" class="lightbox-prev" aria-label="Previous image">←</button><div><p class="lightbox-caption" aria-live="polite"></p><span class="lightbox-counter"></span><a class="lightbox-open" target="_blank" rel="noopener">Open full image ↗</a></div><button type="button" class="lightbox-next" aria-label="Next image">→</button></div>
</dialog>
<script>
  const dialog = document.querySelector<HTMLDialogElement>('.lightbox')!;
  const display = dialog.querySelector<HTMLImageElement>('.lightbox-image')!;
  const caption = dialog.querySelector<HTMLElement>('.lightbox-caption')!;
  const counter = dialog.querySelector<HTMLElement>('.lightbox-counter')!;
  const openLink = dialog.querySelector<HTMLAnchorElement>('.lightbox-open')!;
  const previous = dialog.querySelector<HTMLButtonElement>('.lightbox-prev')!;
  const next = dialog.querySelector<HTMLButtonElement>('.lightbox-next')!;
  let links: HTMLAnchorElement[] = [];
  let position = 0;
  let trigger: HTMLAnchorElement | null = null;
  function show(index: number) {
    position = (index + links.length) % links.length;
    const link = links[position]; display.src = link.href; display.alt = link.dataset.caption || ''; display.hidden = false;
    caption.textContent = link.dataset.caption || ''; counter.textContent = `${position + 1} / ${links.length}`; openLink.href = link.href;
    previous.hidden = next.hidden = links.length < 2;
  }
  document.querySelectorAll<HTMLAnchorElement>('[data-lightbox]').forEach(link => link.addEventListener('click', e => {
    e.preventDefault(); trigger = link;
    links = [...document.querySelectorAll<HTMLAnchorElement>('[data-lightbox]')].filter(l=>!l.closest('[hidden]'));
    show(links.indexOf(link)); dialog.showModal(); document.body.style.overflow = 'hidden';
  }));
  previous.addEventListener('click',()=>show(position-1)); next.addEventListener('click',()=>show(position+1));
  dialog.querySelector('.lightbox-close')?.addEventListener('click',()=>dialog.close());
  dialog.addEventListener('click',e=>{ if(e.target===dialog) dialog.close(); });
  dialog.addEventListener('keydown',e=>{if(e.key==='ArrowLeft'){e.preventDefault();show(position-1);} if(e.key==='ArrowRight'){e.preventDefault();show(position+1);} });
  dialog.addEventListener('close',()=>{ document.body.style.overflow=''; display.removeAttribute('src'); display.hidden=true; trigger?.focus(); });
</script>
<style>
  .lightbox{width:min(1150px,95vw);max-width:95vw;max-height:94vh;border:0;padding:45px 45px 24px;border-radius:5px;background:#101c29;color:#fff;overflow:auto}.lightbox::backdrop{background:rgba(4,13,21,.9);backdrop-filter:blur(6px)}.lightbox-image-wrap{height:min(68vh,750px);display:grid;place-items:center}.lightbox-image{max-height:68vh;max-width:100%;object-fit:contain}.lightbox-close{position:absolute;top:7px;right:14px;font-size:2.1rem;background:none;border:0;color:#fff;line-height:1;padding:5px 12px}.lightbox-bottom{display:flex;justify-content:space-between;align-items:center;gap:20px;margin-top:25px;text-align:center}.lightbox-bottom>button{background:transparent;border:1px solid #516171;color:#fff;border-radius:50%;height:42px;min-width:42px;font-size:1.2rem}.lightbox-caption{font-size:.92rem;margin-bottom:4px}.lightbox-counter,.lightbox-open{font-size:.75rem;color:#acc3d2}.lightbox-open{margin-left:20px;text-decoration:underline}@media(max-width:650px){.lightbox{padding:43px 14px 20px}.lightbox-image-wrap{height:60vh}.lightbox-image{max-height:60vh}.lightbox-bottom{gap:10px}.lightbox-caption{font-size:.78rem}.lightbox-bottom>button{min-width:35px;height:35px}}
</style>
