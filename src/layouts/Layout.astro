---
import '../styles/global.css';
import '../styles/experience.css';
import '../styles/render-performance.css';
import { site, href } from '../lib/site';
import Arrow from '../components/Arrow.astro';
interface Props { title?: string; description?: string; active?: string; home?: boolean; }
const { title, description = site.description, active = '', home = false } = Astro.props;
const pageTitle = title ? `${title} — EMI Lab · TU Delft` : 'EMI Lab — Efficient Machine Intelligence at TU Delft';
const canonical = new URL(Astro.url.pathname, Astro.site);
const navigation = [['News','/news/'],['Research','/research/'],['People','/people/'],['Publications','/publications/'],['Gallery','/gallery/'],['MSc Projects','/msc-projects/']];
const joinLink = ['Join us','/join-us/'];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    {home && <script is:inline>document.documentElement.classList.add('home-story');</script>}
    <script is:inline>
      // Keep local previews and alternate hosts out of the live site's reports.
      if (['www.tudemi.com', 'tudemi.com'].includes(window.location.hostname)) {
        window.dataLayer = window.dataLayer || [];
        window.gtag = function () { window.dataLayer.push(arguments); };
        window.gtag('js', new Date());
        window.gtag('config', 'G-MVRCJ9G874', {
          allow_google_signals: false,
          allow_ad_personalization_signals: false,
        });
        const analyticsScript = document.createElement('script');
        analyticsScript.async = true;
        analyticsScript.src = 'https://www.googletagmanager.com/gtag/js?id=G-MVRCJ9G874';
        document.head.appendChild(analyticsScript);
      }
    </script>
    <title>{pageTitle}</title><meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#fafbfc" />
    <meta property="og:title" content={pageTitle} /><meta property="og:description" content={description} />
    <meta property="og:type" content="website" /><meta property="og:url" content={canonical} />
    <link rel="icon" href={href('/favicon.png?v=20260908-transparent')} type="image/png" sizes="2048x2048" />
    <link rel="alternate" type="application/rss+xml" title="EMI Lab news" href={href('/feed.xml')} />
    <slot name="head" />
  </head>
  <body class:list={['emi-site', { 'home-page': home }]}>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="header-inner wrap">
        <a href={href('/')} class="wordmark" aria-label="EMI Lab home"><img class="emi-logo" src={href('/images/emi-logo.svg')} alt="EMI" width="146" height="48" /><span class="brand-divider"></span><span class="brand-caption"><span class="brand-full-name">{site.fullName}</span><b>TU Delft</b></span></a>
        <nav class="desktop-nav" aria-label="Main navigation">
          {navigation.map(([label,path]) => <a href={href(path)} aria-current={active === label ? 'page' : undefined}>{label}</a>)}
          <a class="nav-join" href={href(joinLink[1])} aria-current={active === joinLink[0] ? 'page' : undefined}>{joinLink[0]} <Arrow diagonal size={15} /></a>
        </nav>
        <div class="header-tools">
          <button class="motion-toggle" data-motion-toggle type="button" aria-pressed="false" aria-label="Pause animations" title="Pause animations" hidden><svg class="motion-pause" viewBox="0 0 12 12" fill="currentColor" aria-hidden="true"><path d="M3 2h2v8H3zm4 0h2v8H7z" /></svg><svg class="motion-play" viewBox="0 0 12 12" fill="currentColor" aria-hidden="true"><path d="m3 1 8 5-8 5z" /></svg></button>
          <button class="menu-toggle" aria-expanded="false" aria-controls="mobile-nav" aria-label="Open navigation"><span></span><span></span></button>
        </div>
      </div>
      <nav id="mobile-nav" class="mobile-nav wrap" aria-label="Mobile navigation" hidden>
        {[...navigation,joinLink,['Grants & awards','/grants-awards/']].map(([label,path]) => <a href={href(path)} aria-current={active === label ? 'page' : undefined}>{label}<Arrow /></a>)}
      </nav>
      <div class="reading-progress" data-reading-progress aria-hidden="true"></div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="footer-signature wrap"><p>Less energy.<br /><em>More possibility.</em></p><a href={href('/join-us/')} aria-label="Start a conversation with EMI"><Arrow diagonal size={29} /></a></div>
      <div class="wrap footer-top">
        <div class="footer-about"><a class="footer-logo" href={href('/')}>EMI<span>.</span></a><p>Lab of Efficient Machine Intelligence<br />Delft University of Technology</p><p class="footer-address">Department of Microelectronics · EEMCS<br />Mekelweg 4, 2628 CD Delft<br />The Netherlands</p></div>
        <div><p class="footer-label">Explore</p><a href={href('/research/')}>Research</a><a href={href('/publications/')}>Publications</a><a href={href('/people/')}>Our people</a><a href={href('/grants-awards/')}>Grants & awards</a></div>
        <div><p class="footer-label">The lab</p><a href={href('/news/')}>News & updates</a><a href={href('/gallery/')}>Life at EMI</a><a href={href('/msc-projects/')}>MSc Projects</a><a href={href('/join-us/')}>Join us</a></div>
        <div><p class="footer-label">Connect</p><a href={`mailto:${site.email}`}>Email the lab <Arrow diagonal size={14} /></a><a href={site.github}>GitHub <Arrow diagonal size={14} /></a><a href={site.scholar}>Google Scholar <Arrow diagonal size={14} /></a><a href="https://microelectronics.tudelft.nl/People/bio.php?id=840">TU Delft profile <Arrow diagonal size={14} /></a></div>
      </div>
      <div class="wrap footer-bottom"><span>© {new Date().getFullYear()} EMI Lab · Chang Gao</span><a href="mailto:gaochangw@outlook.com">Website contact: gaochangw@outlook.com</a><a href={href('/feed.xml')}>RSS feed <Arrow diagonal size={13} /></a></div>
    </footer>
    <script>
      import '../scripts/site-motion';
      const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
      const menu = document.querySelector<HTMLElement>('#mobile-nav');
      function closeMenu() { if (!toggle || !menu) return; toggle.setAttribute('aria-expanded','false'); toggle.setAttribute('aria-label','Open navigation'); menu.hidden = true; }
      toggle?.addEventListener('click', () => { if (!menu) return; const open = toggle.getAttribute('aria-expanded') !== 'true'; toggle.setAttribute('aria-expanded',String(open)); toggle.setAttribute('aria-label',open ? 'Close navigation' : 'Open navigation'); menu.hidden = !open; });
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') { closeMenu(); toggle.focus(); } });
      matchMedia('(min-width: 1025px)').addEventListener('change', e => { if(e.matches) closeMenu(); });
    </script>
  </body>
</html>
